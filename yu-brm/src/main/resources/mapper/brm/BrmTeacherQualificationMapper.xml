<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yu.brm.mapper.BrmTeacherQualificationMapper">
    <resultMap type="BrmTeacherQualification" id="BrmTeacherQualificationResult">
        <result property="qualId"            column="qual_id"            />
        <result property="teacherId"         column="teacher_id"         />
        <result property="courseCategory"    column="course_category"    />
        <result property="certifyAuthority"  column="certify_authority"  />
        <result property="qualifyDate"       column="qualify_date"       />
        <result property="expireDate"        column="expire_date"        />
        <result property="status"            column="status"             />
        <result property="createBy"          column="create_by"          />
        <result property="createTime"        column="create_time"        />
        <result property="updateBy"          column="update_by"          />
        <result property="updateTime"        column="update_time"        />
        <result property="remark"            column="remark"             />
    </resultMap>
    <sql id="selectBrmTeacherQualificationVo">
        select qual_id, teacher_id, course_category, certify_authority, qualify_date, expire_date, status, create_by, create_time, update_by, update_time, remark from brm_teacher_qualification
    </sql>
    <select id="selectBrmTeacherQualificationList" parameterType="BrmTeacherQualification" resultMap="BrmTeacherQualificationResult">
        <include refid="selectBrmTeacherQualificationVo"/>
        <where>
            <if test="teacherId != null"> and teacher_id = #{teacherId}</if>
            <if test="courseCategory != null and courseCategory.trim() != ''"> and course_category like concat('%', #{courseCategory}, '%')</if>
            <if test="status != null and status.trim() != ''"> and status = #{status}</if>
        </where>
    </select>
    <select id="selectBrmTeacherQualificationByQualId" parameterType="Long" resultMap="BrmTeacherQualificationResult">
        <include refid="selectBrmTeacherQualificationVo"/> where qual_id = #{qualId}
    </select>
    <insert id="insertBrmTeacherQualification" parameterType="BrmTeacherQualification" useGeneratedKeys="true" keyProperty="qualId">
        insert into brm_teacher_qualification
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="teacherId != null">teacher_id,</if>
            <if test="courseCategory != null and courseCategory != ''">course_category,</if>
            <if test="certifyAuthority != null">certify_authority,</if>
            <if test="qualifyDate != null">qualify_date,</if>
            <if test="expireDate != null">expire_date,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="teacherId != null">#{teacherId},</if>
            <if test="courseCategory != null and courseCategory != ''">#{courseCategory},</if>
            <if test="certifyAuthority != null">#{certifyAuthority},</if>
            <if test="qualifyDate != null">#{qualifyDate},</if>
            <if test="expireDate != null">#{expireDate},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>
    <update id="updateBrmTeacherQualification" parameterType="BrmTeacherQualification">
        update brm_teacher_qualification
        <trim prefix="SET" suffixOverrides=",">
            <if test="teacherId != null">teacher_id = #{teacherId},</if>
            <if test="courseCategory != null and courseCategory != ''">course_category = #{courseCategory},</if>
            <if test="certifyAuthority != null">certify_authority = #{certifyAuthority},</if>
            <if test="qualifyDate != null">qualify_date = #{qualifyDate},</if>
            <if test="expireDate != null">expire_date = #{expireDate},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where qual_id = #{qualId}
    </update>
    <delete id="deleteBrmTeacherQualificationByQualId" parameterType="Long">
        delete from brm_teacher_qualification where qual_id = #{qualId}
    </delete>
    <delete id="deleteBrmTeacherQualificationByQualIds" parameterType="String">
        delete from brm_teacher_qualification where qual_id in
        <foreach item="qualId" collection="array" open="(" separator="," close=")">#{qualId}</foreach>
    </delete>
</mapper>
