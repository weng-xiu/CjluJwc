<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yu.brm.mapper.BrmClassroomMapper">
    <resultMap type="BrmClassroom" id="BrmClassroomResult">
        <result property="classroomId"     column="classroom_id"       />
        <result property="classroomName"   column="classroom_name"     />
        <result property="buildingId"      column="building_id"        />
        <result property="typeId"          column="type_id"            />
        <result property="capacity"        column="capacity"           />
        <result property="status"          column="status"             />
        <result property="createBy"        column="create_by"          />
        <result property="createTime"      column="create_time"        />
        <result property="updateBy"        column="update_by"          />
        <result property="updateTime"      column="update_time"        />
        <result property="remark"          column="remark"             />
        <result property="buildingName"    column="building_name"      />
        <result property="typeName"        column="type_name"          />
    </resultMap>
    <sql id="selectBrmClassroomVo">select classroom_id, classroom_name, building_id, type_id, capacity, status, create_by, create_time, update_by, update_time, remark from brm_classroom</sql>
    <select id="selectBrmClassroomList" parameterType="BrmClassroom" resultMap="BrmClassroomResult">
        select c.classroom_id, c.classroom_name, c.building_id, c.type_id, c.capacity, c.status, c.create_by, c.create_time, c.update_by, c.update_time, c.remark,
               b.building_name as building_name,
               ct.type_name as type_name
        from brm_classroom c
        left join brm_building b on c.building_id = b.building_id
        left join brm_classroom_type ct on c.type_id = ct.type_id
        <where>
            <if test="classroomName != null and classroomName.trim() != ''"> and c.classroom_name like concat('%', #{classroomName}, '%')</if>
            <if test="buildingId != null"> and c.building_id = #{buildingId}</if>
            <if test="typeId != null"> and c.type_id = #{typeId}</if>
            <if test="status != null and status.trim() != ''"> and c.status = #{status}</if>
        </where>
    </select>
    <select id="selectBrmClassroomByClassroomId" parameterType="Long" resultMap="BrmClassroomResult"><include refid="selectBrmClassroomVo"/> where classroom_id = #{classroomId}</select>
    <select id="selectByBuildingAndName" resultMap="BrmClassroomResult">
        <include refid="selectBrmClassroomVo"/>
        where building_id = #{buildingId} and classroom_name = #{classroomName} limit 1
    </select>
    <insert id="insertBrmClassroom" parameterType="BrmClassroom" useGeneratedKeys="true" keyProperty="classroomId">insert into brm_classroom
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="classroomName != null and classroomName != ''">classroom_name,</if><if test="buildingId != null">building_id,</if>
            <if test="typeId != null">type_id,</if><if test="capacity != null">capacity,</if>
            <if test="status != null">status,</if><if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if><if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="classroomName != null and classroomName != ''">#{classroomName},</if><if test="buildingId != null">#{buildingId},</if>
            <if test="typeId != null">#{typeId},</if><if test="capacity != null">#{capacity},</if>
            <if test="status != null">#{status},</if><if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if><if test="remark != null">#{remark},</if>
        </trim>
    </insert>
    <update id="updateBrmClassroom" parameterType="BrmClassroom">update brm_classroom
        <trim prefix="SET" suffixOverrides=",">
            <if test="classroomName != null and classroomName != ''">classroom_name = #{classroomName},</if><if test="buildingId != null">building_id = #{buildingId},</if>
            <if test="typeId != null">type_id = #{typeId},</if><if test="capacity != null">capacity = #{capacity},</if>
            <if test="status != null">status = #{status},</if><if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if><if test="remark != null">remark = #{remark},</if>
        </trim> where classroom_id = #{classroomId}
    </update>
    <delete id="deleteBrmClassroomByClassroomId" parameterType="Long">delete from brm_classroom where classroom_id = #{classroomId}</delete>
    <delete id="deleteBrmClassroomByClassroomIds" parameterType="String">delete from brm_classroom where classroom_id in <foreach item="classroomId" collection="array" open="(" separator="," close=")">#{classroomId}</foreach></delete>

    <!-- 按最小容量查询教室列表（含教学楼名称、教室类型名称） -->
    <select id="selectByMinCapacity" resultType="BrmClassroom">
        select c.classroom_id, c.classroom_name, c.building_id, c.type_id, c.capacity, c.status,
               b.building_name as building_name,
               ct.type_name as type_name
        from brm_classroom c
        left join brm_building b on c.building_id = b.building_id
        left join brm_classroom_type ct on c.type_id = ct.type_id
        where c.status = '0'
        <if test="minCapacity != null">
          and c.capacity &gt;= #{minCapacity}
        </if>
        order by c.capacity asc
    </select>
</mapper>
