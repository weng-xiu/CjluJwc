<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yu.brm.mapper.BrmEquipmentMapper">
    <resultMap type="BrmEquipment" id="BrmEquipmentResult">
        <result property="equipId"       column="equip_id"       />
        <result property="equipName"     column="equip_name"     />
        <result property="classroomId"   column="classroom_id"   />
        <result property="equipType"     column="equip_type"     />
        <result property="model"         column="model"          />
        <result property="purchaseDate"  column="purchase_date"  />
        <result property="status"        column="status"         />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"        column="remark"         />
    </resultMap>
    <sql id="selectBrmEquipmentVo">
        select equip_id, equip_name, classroom_id, equip_type, model, purchase_date, status, create_by, create_time, update_by, update_time, remark from brm_equipment
    </sql>
    <select id="selectBrmEquipmentList" parameterType="BrmEquipment" resultMap="BrmEquipmentResult">
        <include refid="selectBrmEquipmentVo"/>
        <where>
            <if test="equipName != null and equipName.trim() != ''"> and equip_name like concat('%', #{equipName}, '%')</if>
            <if test="classroomId != null"> and classroom_id = #{classroomId}</if>
            <if test="equipType != null and equipType.trim() != ''"> and equip_type = #{equipType}</if>
            <if test="status != null and status.trim() != ''"> and status = #{status}</if>
        </where>
    </select>
    <select id="selectBrmEquipmentByEquipId" parameterType="Long" resultMap="BrmEquipmentResult">
        <include refid="selectBrmEquipmentVo"/> where equip_id = #{equipId}
    </select>
    <insert id="insertBrmEquipment" parameterType="BrmEquipment" useGeneratedKeys="true" keyProperty="equipId">
        insert into brm_equipment
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="equipName != null and equipName != ''">equip_name,</if>
            <if test="classroomId != null">classroom_id,</if>
            <if test="equipType != null">equip_type,</if>
            <if test="model != null">model,</if>
            <if test="purchaseDate != null">purchase_date,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="equipName != null and equipName != ''">#{equipName},</if>
            <if test="classroomId != null">#{classroomId},</if>
            <if test="equipType != null">#{equipType},</if>
            <if test="model != null">#{model},</if>
            <if test="purchaseDate != null">#{purchaseDate},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>
    <update id="updateBrmEquipment" parameterType="BrmEquipment">
        update brm_equipment
        <trim prefix="SET" suffixOverrides=",">
            <if test="equipName != null and equipName != ''">equip_name = #{equipName},</if>
            <if test="classroomId != null">classroom_id = #{classroomId},</if>
            <if test="equipType != null">equip_type = #{equipType},</if>
            <if test="model != null">model = #{model},</if>
            <if test="purchaseDate != null">purchase_date = #{purchaseDate},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where equip_id = #{equipId}
    </update>
    <delete id="deleteBrmEquipmentByEquipId" parameterType="Long">
        delete from brm_equipment where equip_id = #{equipId}
    </delete>
    <delete id="deleteBrmEquipmentByEquipIds" parameterType="String">
        delete from brm_equipment where equip_id in
        <foreach item="equipId" collection="array" open="(" separator="," close=")">#{equipId}</foreach>
    </delete>
</mapper>
