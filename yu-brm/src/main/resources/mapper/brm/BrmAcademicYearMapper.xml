<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yu.brm.mapper.BrmAcademicYearMapper">
    <resultMap type="BrmAcademicYear" id="BrmAcademicYearResult">
        <result property="yearId"       column="year_id"       />
        <result property="yearName"     column="year_name"     />
        <result property="startDate"    column="start_date"    />
        <result property="endDate"      column="end_date"      />
        <result property="status"       column="status"        />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="create_time"   />
        <result property="updateBy"     column="update_by"     />
        <result property="updateTime"   column="update_time"   />
        <result property="remark"       column="remark"        />
    </resultMap>
    <sql id="selectBrmAcademicYearVo">
        select year_id, year_name, start_date, end_date, status, create_by, create_time, update_by, update_time, remark from brm_academic_year
    </sql>
    <select id="selectBrmAcademicYearList" parameterType="BrmAcademicYear" resultMap="BrmAcademicYearResult">
        <include refid="selectBrmAcademicYearVo"/>
        <where>
            <if test="yearName != null and yearName.trim() != ''"> and year_name like concat('%', #{yearName}, '%')</if>
            <if test="status != null and status.trim() != ''"> and status = #{status}</if>
        </where>
    </select>
    <select id="selectBrmAcademicYearByYearId" parameterType="Long" resultMap="BrmAcademicYearResult">
        <include refid="selectBrmAcademicYearVo"/> where year_id = #{yearId}
    </select>
    <insert id="insertBrmAcademicYear" parameterType="BrmAcademicYear" useGeneratedKeys="true" keyProperty="yearId">
        insert into brm_academic_year
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="yearName != null and yearName != ''">year_name,</if>
            <if test="startDate != null">start_date,</if>
            <if test="endDate != null">end_date,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="yearName != null and yearName != ''">#{yearName},</if>
            <if test="startDate != null">#{startDate},</if>
            <if test="endDate != null">#{endDate},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>
    <update id="updateBrmAcademicYear" parameterType="BrmAcademicYear">
        update brm_academic_year
        <trim prefix="SET" suffixOverrides=",">
            <if test="yearName != null and yearName != ''">year_name = #{yearName},</if>
            <if test="startDate != null">start_date = #{startDate},</if>
            <if test="endDate != null">end_date = #{endDate},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where year_id = #{yearId}
    </update>
    <delete id="deleteBrmAcademicYearByYearId" parameterType="Long">
        delete from brm_academic_year where year_id = #{yearId}
    </delete>
    <delete id="deleteBrmAcademicYearByYearIds" parameterType="String">
        delete from brm_academic_year where year_id in
        <foreach item="yearId" collection="array" open="(" separator="," close=")">#{yearId}</foreach>
    </delete>
</mapper>
