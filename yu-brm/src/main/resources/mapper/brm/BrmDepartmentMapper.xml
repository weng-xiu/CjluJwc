<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yu.brm.mapper.BrmDepartmentMapper">

    <resultMap id="SysDeptResult" type="com.yu.common.core.domain.entity.SysDept">
        <id column="dept_id" property="deptId"/>
        <result column="parent_id" property="parentId"/>
        <result column="ancestors" property="ancestors"/>
        <result column="dept_name" property="deptName"/>
        <result column="order_num" property="orderNum"/>
        <result column="leader" property="leader"/>
        <result column="phone" property="phone"/>
        <result column="email" property="email"/>
        <result column="status" property="status"/>
        <result column="del_flag" property="delFlag"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>
    <resultMap type="BrmDepartment" id="BrmDepartmentResult">
        <result property="deptId"     column="dept_id"      />
        <result property="parentId"   column="parent_id"    />
        <result property="ancestors"  column="ancestors"    />
        <result property="deptCode"   column="dept_code"    />
        <result property="deptName"   column="dept_name"    />
        <result property="leader"     column="leader"       />
        <result property="phone"      column="phone"        />
        <result property="email"      column="email"        />
        <result property="orderNum"   column="order_num"    />
        <result property="status"     column="status"       />
        <result property="delFlag"    column="del_flag"     />
        <result property="createBy"   column="create_by"    />
        <result property="createTime" column="create_time"  />
        <result property="updateBy"   column="update_by"    />
        <result property="updateTime" column="update_time"  />
        <result property="remark"     column="remark"       />
    </resultMap>
    <sql id="selectBrmDepartmentVo">
        select d.dept_id, d.parent_id, d.ancestors, d.dept_code, d.dept_name, d.leader, d.phone, d.email, d.order_num, d.status, d.del_flag, d.create_by, d.create_time, d.update_by, d.update_time, d.remark from brm_department d
    </sql>
    <select id="selectBrmDepartmentList" parameterType="BrmDepartment" resultMap="BrmDepartmentResult">
        <include refid="selectBrmDepartmentVo"/> where d.del_flag = '0'
        <if test="deptName != null and deptName.trim() != ''"> and d.dept_name like concat('%', #{deptName}, '%')</if>
        <if test="status != null and status.trim() != ''"> and d.status = #{status}</if>
        order by d.parent_id, d.order_num
    </select>
    <select id="selectBrmDepartmentByDeptId" parameterType="Long" resultMap="BrmDepartmentResult">
        <include refid="selectBrmDepartmentVo"/> where d.dept_id = #{deptId}
    </select>
    <select id="selectChildrenDeptById" parameterType="Long" resultMap="BrmDepartmentResult">
        select * from brm_department where find_in_set(#{deptId}, ancestors)
    </select>
    <select id="checkDeptExistUser" parameterType="Long" resultType="int">
        select count(1) from brm_teacher where dept_id = #{deptId} and del_flag = '0'
    </select>
    <select id="checkDeptNameUnique" parameterType="String" resultMap="BrmDepartmentResult">
        <include refid="selectBrmDepartmentVo"/> where d.dept_name=#{deptName} and d.parent_id = #{parentId} and d.del_flag = '0' limit 1
    </select>
    <insert id="insertBrmDepartment" parameterType="BrmDepartment">
        insert into brm_department
        (dept_id, parent_id, ancestors, dept_code, dept_name, leader, phone, email, order_num, status, del_flag, create_by, create_time, update_by, update_time, remark)
        values
        (#{deptId}, #{parentId}, #{ancestors}, #{deptCode}, #{deptName}, #{leader}, #{phone}, #{email}, #{orderNum}, #{status}, #{delFlag}, #{createBy}, #{createTime}, #{updateBy}, #{updateTime}, #{remark})
    </insert>
    <update id="updateBrmDepartment" parameterType="BrmDepartment">
        update brm_department
        <trim prefix="SET" suffixOverrides=",">
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="ancestors != null">ancestors = #{ancestors},</if>
            <if test="deptCode != null and deptCode != ''">dept_code = #{deptCode},</if>
            <if test="deptName != null and deptName != ''">dept_name = #{deptName},</if>
            <if test="leader != null">leader = #{leader},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="email != null">email = #{email},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where dept_id = #{deptId}
    </update>
    <update id="updateBrmDepartmentChildren" parameterType="java.util.List">
        update brm_department set ancestors =
        <foreach collection="children" item="item" index="index" separator=" " open="case dept_id" close="end">
            when #{item.deptId} then #{item.ancestors}
        </foreach>
        where dept_id in
        <foreach collection="children" item="item" open="(" separator="," close=")">#{item.deptId}</foreach>
    </update>
    <delete id="deleteBrmDepartmentByDeptId" parameterType="Long">
        update brm_department set del_flag = '2' where dept_id = #{deptId}
    </delete>
    <delete id="deleteBrmDepartmentByDeptIds" parameterType="String">
        update brm_department set del_flag = '2' where dept_id in
        <foreach item="deptId" collection="array" open="(" separator="," close=")">#{deptId}</foreach>
    </delete>

    <!-- 全量同步用：清空 brm_department（物理清空，同步前重置） -->
    <delete id="deleteAllBrmDepartment">
        delete from brm_department
    </delete>

    <!-- 全量同步用：直接查询 sys_dept（与 brm_department 同库，共享 dept_id） -->
    <select id="selectAllSysDept" resultMap="SysDeptResult">
        select dept_id, parent_id, ancestors, dept_name, leader, phone, email, order_num, status, del_flag, create_by, create_time, update_by, update_time
        from sys_dept
        where del_flag = '0'
        order by parent_id, order_num
    </select>
</mapper>
