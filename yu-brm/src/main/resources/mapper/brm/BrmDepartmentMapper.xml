<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yu.brm.mapper.BrmDepartmentMapper">
    <resultMap type="BrmDepartment" id="BrmDepartmentResult">
        <result property="deptId"     column="dept_id"      />
        <result property="parentId"   column="parent_id"    />
        <result property="ancestors"  column="ancestors"    />
        <result property="deptCode"   column="dept_code"    />
        <result property="deptName"   column="dept_name"    />
        <result property="leader"     column="leader"       />
        <result property="phone"      column="phone"        />
        <result property="email"      column="email"        />
        <result property="orderNum"   column="order_num"    />
        <result property="status"     column="status"       />
        <result property="delFlag"    column="del_flag"     />
        <result property="createBy"   column="create_by"    />
        <result property="createTime" column="create_time"  />
        <result property="updateBy"   column="update_by"    />
        <result property="updateTime" column="update_time"  />
        <result property="remark"     column="remark"       />
    </resultMap>
    <sql id="selectBrmDepartmentVo">
        select d.dept_id, d.parent_id, d.ancestors, d.dept_code, d.dept_name, d.leader, d.phone, d.email, d.order_num, d.status, d.del_flag, d.create_by, d.create_time, d.update_by, d.update_time, d.remark from brm_department d
    </sql>
    <select id="selectBrmDepartmentList" parameterType="BrmDepartment" resultMap="BrmDepartmentResult">
        <include refid="selectBrmDepartmentVo"/> where d.del_flag = '0'
        <if test="deptName != null and deptName.trim() != ''"> and d.dept_name like concat('%', #{deptName}, '%')</if>
        <if test="status != null and status.trim() != ''"> and d.status = #{status}</if>
        order by d.parent_id, d.order_num
    </select>
    <select id="selectBrmDepartmentByDeptId" parameterType="Long" resultMap="BrmDepartmentResult">
        <include refid="selectBrmDepartmentVo"/> where d.dept_id = #{deptId}
    </select>
    <select id="selectChildrenDeptById" parameterType="Long" resultMap="BrmDepartmentResult">
        select * from brm_department where find_in_set(#{deptId}, ancestors)
    </select>
    <select id="checkDeptExistUser" parameterType="Long" resultType="int">
        select count(1) from brm_teacher where dept_id = #{deptId} and del_flag = '0'
    </select>
    <select id="checkDeptNameUnique" parameterType="String" resultMap="BrmDepartmentResult">
        <include refid="selectBrmDepartmentVo"/> where d.dept_name=#{deptName} and d.parent_id = #{parentId} and d.del_flag = '0' limit 1
    </select>
    <insert id="insertBrmDepartment" parameterType="BrmDepartment" useGeneratedKeys="true" keyProperty="deptId">
        insert into brm_department
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="parentId != null">parent_id,</if>
            <if test="ancestors != null">ancestors,</if>
            <if test="deptCode != null and deptCode != ''">dept_code,</if>
            <if test="deptName != null and deptName != ''">dept_name,</if>
            <if test="leader != null">leader,</if>
            <if test="phone != null">phone,</if>
            <if test="email != null">email,</if>
            <if test="orderNum != null">order_num,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="parentId != null">#{parentId},</if>
            <if test="ancestors != null">#{ancestors},</if>
            <if test="deptCode != null and deptCode != ''">#{deptCode},</if>
            <if test="deptName != null and deptName != ''">#{deptName},</if>
            <if test="leader != null">#{leader},</if>
            <if test="phone != null">#{phone},</if>
            <if test="email != null">#{email},</if>
            <if test="orderNum != null">#{orderNum},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>
    <update id="updateBrmDepartment" parameterType="BrmDepartment">
        update brm_department
        <trim prefix="SET" suffixOverrides=",">
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="ancestors != null">ancestors = #{ancestors},</if>
            <if test="deptCode != null and deptCode != ''">dept_code = #{deptCode},</if>
            <if test="deptName != null and deptName != ''">dept_name = #{deptName},</if>
            <if test="leader != null">leader = #{leader},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="email != null">email = #{email},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where dept_id = #{deptId}
    </update>
    <update id="updateBrmDepartmentChildren" parameterType="java.util.List">
        update brm_department set ancestors =
        <foreach collection="children" item="item" index="index" separator=" " open="case dept_id" close="end">
            when #{item.deptId} then #{item.ancestors}
        </foreach>
        where dept_id in
        <foreach collection="children" item="item" open="(" separator="," close=")">#{item.deptId}</foreach>
    </update>
    <delete id="deleteBrmDepartmentByDeptId" parameterType="Long">
        update brm_department set del_flag = '2' where dept_id = #{deptId}
    </delete>
    <delete id="deleteBrmDepartmentByDeptIds" parameterType="String">
        update brm_department set del_flag = '2' where dept_id in
        <foreach item="deptId" collection="array" open="(" separator="," close=")">#{deptId}</foreach>
    </delete>
</mapper>
