<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yu.brm.mapper.BrmClassroomTypeMapper">
    <resultMap type="BrmClassroomType" id="BrmClassroomTypeResult">
        <result property="typeId"     column="type_id"     />
        <result property="typeName"   column="type_name"   />
        <result property="typeDesc"   column="type_desc"   />
        <result property="status"     column="status"      />
        <result property="createBy"   column="create_by"   />
        <result property="createTime" column="create_time" />
        <result property="updateBy"   column="update_by"   />
        <result property="updateTime" column="update_time" />
        <result property="remark"     column="remark"      />
    </resultMap>
    <sql id="selectBrmClassroomTypeVo">
        select type_id, type_name, type_desc, status, create_by, create_time, update_by, update_time, remark from brm_classroom_type
    </sql>
    <select id="selectBrmClassroomTypeList" parameterType="BrmClassroomType" resultMap="BrmClassroomTypeResult">
        <include refid="selectBrmClassroomTypeVo"/>
        <where>
            <if test="typeName != null and typeName.trim() != ''"> and type_name like concat('%', #{typeName}, '%')</if>
            <if test="status != null and status.trim() != ''"> and status = #{status}</if>
        </where>
    </select>
    <select id="selectBrmClassroomTypeByTypeId" parameterType="Long" resultMap="BrmClassroomTypeResult">
        <include refid="selectBrmClassroomTypeVo"/> where type_id = #{typeId}
    </select>
    <insert id="insertBrmClassroomType" parameterType="BrmClassroomType" useGeneratedKeys="true" keyProperty="typeId">
        insert into brm_classroom_type
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="typeName != null and typeName != ''">type_name,</if>
            <if test="typeDesc != null">type_desc,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="typeName != null and typeName != ''">#{typeName},</if>
            <if test="typeDesc != null">#{typeDesc},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>
    <update id="updateBrmClassroomType" parameterType="BrmClassroomType">
        update brm_classroom_type
        <trim prefix="SET" suffixOverrides=",">
            <if test="typeName != null and typeName != ''">type_name = #{typeName},</if>
            <if test="typeDesc != null">type_desc = #{typeDesc},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where type_id = #{typeId}
    </update>
    <delete id="deleteBrmClassroomTypeByTypeId" parameterType="Long">
        delete from brm_classroom_type where type_id = #{typeId}
    </delete>
    <delete id="deleteBrmClassroomTypeByTypeIds" parameterType="String">
        delete from brm_classroom_type where type_id in
        <foreach item="typeId" collection="array" open="(" separator="," close=")">#{typeId}</foreach>
    </delete>
</mapper>
