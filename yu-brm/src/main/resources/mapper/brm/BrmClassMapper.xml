<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yu.brm.mapper.BrmClassMapper">
    <resultMap type="BrmClass" id="BrmClassResult">
        <result property="classId"       column="class_id"       />
        <result property="classCode"     column="class_code"     />
        <result property="className"     column="class_name"     />
        <result property="majorId"       column="major_id"       />
        <result property="grade"         column="grade"          />
        <result property="studentCount"  column="student_count"  />
        <result property="status"        column="status"         />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"        column="remark"         />
    </resultMap>
    <sql id="selectBrmClassVo">select class_id, class_code, class_name, major_id, grade, student_count, status, create_by, create_time, update_by, update_time, remark from brm_class</sql>
    <select id="selectBrmClassList" parameterType="BrmClass" resultMap="BrmClassResult">
        <include refid="selectBrmClassVo"/><where>
            <if test="className != null and className.trim() != ''"> and class_name like concat('%', #{className}, '%')</if>
            <if test="classCode != null and classCode.trim() != ''"> and class_code like concat('%', #{classCode}, '%')</if>
            <if test="majorId != null"> and major_id = #{majorId}</if>
            <if test="grade != null and grade.trim() != ''"> and grade = #{grade}</if>
            <if test="status != null and status.trim() != ''"> and status = #{status}</if>
        </where>
    </select>
    <select id="selectBrmClassByClassId" parameterType="Long" resultMap="BrmClassResult"><include refid="selectBrmClassVo"/> where class_id = #{classId}</select>
    <insert id="insertBrmClass" parameterType="BrmClass" useGeneratedKeys="true" keyProperty="classId">insert into brm_class
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="classCode != null and classCode != ''">class_code,</if><if test="className != null and className != ''">class_name,</if>
            <if test="majorId != null">major_id,</if><if test="grade != null">grade,</if>
            <if test="studentCount != null">student_count,</if><if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if><if test="createTime != null">create_time,</if><if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="classCode != null and classCode != ''">#{classCode},</if><if test="className != null and className != ''">#{className},</if>
            <if test="majorId != null">#{majorId},</if><if test="grade != null">#{grade},</if>
            <if test="studentCount != null">#{studentCount},</if><if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if><if test="createTime != null">#{createTime},</if><if test="remark != null">#{remark},</if>
        </trim>
    </insert>
    <update id="updateBrmClass" parameterType="BrmClass">update brm_class
        <trim prefix="SET" suffixOverrides=",">
            <if test="classCode != null and classCode != ''">class_code = #{classCode},</if><if test="className != null and className != ''">class_name = #{className},</if>
            <if test="majorId != null">major_id = #{majorId},</if><if test="grade != null">grade = #{grade},</if>
            <if test="studentCount != null">student_count = #{studentCount},</if><if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if><if test="updateTime != null">update_time = #{updateTime},</if><if test="remark != null">remark = #{remark},</if>
        </trim> where class_id = #{classId}
    </update>
    <delete id="deleteBrmClassByClassId" parameterType="Long">delete from brm_class where class_id = #{classId}</delete>
    <delete id="deleteBrmClassByClassIds" parameterType="String">delete from brm_class where class_id in <foreach item="classId" collection="array" open="(" separator="," close=")">#{classId}</foreach></delete>
</mapper>
