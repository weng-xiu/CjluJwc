{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 0,
  "title": "长江大学教务管理系统 - 可观测性（Q3）",
  "tags": ["cjlu-jwc", "observability", "q3"],
  "timezone": "Asia/Shanghai",
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "uid": "cjlu-jwc-observability",
  "panels": [
    {
      "type": "timeseries",
      "title": "JVM 堆内存（used / max）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{application=\"cjlu-jwc-backend\",area=\"heap\"})",
          "legendFormat": "已用堆"
        },
        {
          "refId": "B",
          "expr": "sum(jvm_memory_max_bytes{application=\"cjlu-jwc-backend\",area=\"heap\"})",
          "legendFormat": "堆上限"
        }
      ]
    },
    {
      "type": "stat",
      "title": "堆内存使用率",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(jvm_memory_used_bytes{application=\"cjlu-jwc-backend\",area=\"heap\"}) / sum(jvm_memory_max_bytes{application=\"cjlu-jwc-backend\",area=\"heap\"})",
          "legendFormat": "使用率"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP 接口请求速率 (QPS)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"cjlu-jwc-backend\"}[1m])) by (uri)",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP 5xx 错误率",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 5 } ] } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(http_server_requests_seconds_count{application=\"cjlu-jwc-backend\",outcome=\"SERVER_ERROR\"}[5m])) / sum(rate(http_server_requests_seconds_count{application=\"cjlu-jwc-backend\"}[5m]))",
          "legendFormat": "5xx 占比"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "接口耗时 P95",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"cjlu-jwc-backend\"}[5m])) by (le, uri))",
          "legendFormat": "{{uri}} P95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "选课尖峰：调用速率与成功率",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(yu_biz_total{application=\"cjlu-jwc-backend\",event=\"selection\"}[1m])) by (result)",
          "legendFormat": "选课 {{result}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(yu_biz_total{application=\"cjlu-jwc-backend\",event=\"approval\"}[1m])) by (result)",
          "legendFormat": "审核 {{result}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "关键动作耗时 P95（选课 / 审核）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(yu_biz_duration_seconds_bucket{application=\"cjlu-jwc-backend\",event=\"selection\"}[5m])) by (le))",
          "legendFormat": "选课 P95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(yu_biz_duration_seconds_bucket{application=\"cjlu-jwc-backend\",event=\"approval\"}[5m])) by (le))",
          "legendFormat": "审核 P95"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "学业预警触发分布（按级别）",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "displayMode": "gradient",
        "orientation": "horizontal"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(yu_warning_triggered{application=\"cjlu-jwc-backend\"}[1d])) by (level)",
          "legendFormat": "级别 {{level}}"
        }
      ]
    }
  ],
  "time": { "from": "now-6h", "to": "now" }
}
