# CjluJwc docker-compose 环境变量样例
# 用法：复制为 .env（.env 已被 gitignore 排除，禁止提交真实密钥）后按需修改
# cp .env.example .env

# ---------- MySQL ----------
# root 密码（首启以该密码初始化；不再自动导入仓库内 dump，
# 需首启导入时请按 docker/mysql-init/README.md 放置脱敏脚本）
DB_PASSWORD=root
# 宿主机映射端口（避开本机已占用的 3306；应用容器内部仍走 3306）
DB_PORT_EXPOSE=3307

# ---------- Redis ----------
# 留空表示无密码（演示环境）；生产务必设置
REDIS_PASSWORD=
REDIS_PORT_EXPOSE=6380

# ---------- 后端 / 前端 ----------
BACKEND_PORT_EXPOSE=8080
FRONTEND_PORT_EXPOSE=80
# 门户端（师生服务）宿主端口，与管理端 80 分开；如 81 被占可改
PORTAL_PORT_EXPOSE=81
# 门户内“管理入口”跳转的管理端对外地址（构建期烧入，改动后需 --build 重建门户镜像）
# 例：http://10.10.10.10:80 或 https://jwc.yangtze.edu.cn；留空则不跳转（停在门户登录页）
PORTAL_ADMIN_URL=

# ---------- JWT 令牌密钥（Q4 安全加固） ----------
# 生产/多实例务必设置为强随机串（>=64 字节）；留空则后端启动生成一次性随机密钥（重启令牌失效）
# 生成示例：openssl rand -base64 64
TOKEN_SECRET=

# ---------- 运行 profile 与数据库版本管理（V4.0 §7.3/C2、K1） ----------
# compose 内默认 prod（关文档端点与监控台、日志降噪）；本地联调可临时改 dev
SPRING_PROFILES_ACTIVE=prod
# Flyway 默认关闭，避免误改现有库；全新空库首启建议置 true
FLYWAY_ENABLED=false
# 日志保留天数
LOG_MAX_HISTORY=30

# ---------- 后端容器资源限制（JVM 按 MaxRAMPercentage 感知 mem_limit） ----------
BACKEND_MEM_LIMIT=2g
BACKEND_CPU_LIMIT=2.0

# ---------- 仅当确实需要暴露 Druid 监控台时填写（prod 保持关闭） ----------
DRUID_STAT_VIEW_ENABLED=false
DRUID_LOGIN_USERNAME=
DRUID_LOGIN_PASSWORD=
DOC_ENDPOINT_PERMIT_ALL=false
SWAGGER_UI_ENABLED=false

# ---------- 可观测性（Q3：Prometheus + Grafana） ----------
# 后端独立管理端口（容器内），actuator 指标/Prometheus 走此端口，与业务 JWT 鉴权链隔离；
# 8081 不对宿主暴露，Prometheus 容器在同网内直连 backend:8081/actuator/prometheus 抓取。
MGMT_SERVER_PORT=8081
MANAGEMENT_EXPOSURE_INCLUDE=health,info,metrics,prometheus
APPLICATION_NAME=cjlu-jwc-backend
# Prometheus / Grafana 宿主端口（仅绑定 127.0.0.1，需本机浏览器访问）
PROMETHEUS_PORT_EXPOSE=9090
GRAFANA_PORT_EXPOSE=3000
# Prometheus 指标保留时长
PROMETHEUS_RETENTION=15d
# Grafana 管理员账号（生产务必改强密码）
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
