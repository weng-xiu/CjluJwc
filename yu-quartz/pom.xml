<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>yu</artifactId>
        <groupId>com.yu</groupId>
        <version>3.9.2</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>yu-quartz</artifactId>

    <properties>
        <!-- JaCoCo 行覆盖率防回归棘轮（G5/V6.7 首次建基线）：全量单测复跑实测 15.52%（81/522，6 例）；
             本模块仅 522 行，新增一个未覆盖的类就能把比例拉掉 15 点以上，故比「实测 − 2 点」再多留 1 点，取 0.12 -->
        <jacoco.line.minimum>0.12</jacoco.line.minimum>
    </properties>

    <description>
        quartz定时任务
    </description>

    <dependencies>

        <!-- 定时任务 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-quartz</artifactId>
        </dependency>

        <!-- 通用工具-->
        <dependency>
            <groupId>com.yu</groupId>
            <artifactId>yu-common</artifactId>
        </dependency>

        <!-- 学籍与学位管理模块（学业预警引擎）-->
        <dependency>
            <groupId>com.yu</groupId>
            <artifactId>yu-sam</artifactId>
        </dependency>

        <!-- 系统模块（定时任务失败告警使用 ISysNoticeService）-->
        <dependency>
            <groupId>com.yu</groupId>
            <artifactId>yu-system</artifactId>
        </dependency>

        <!-- 可观测性（Q3）：资源告警任务读取 Micrometer 指标（JVM 水位/接口 5xx 错误率）-->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>

        <!-- 单元测试（P2 告警水位逻辑：SimpleMeterRegistry + Mockito）-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>