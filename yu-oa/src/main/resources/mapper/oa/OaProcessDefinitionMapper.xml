<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yu.oa.mapper.OaProcessDefinitionMapper">
    <resultMap type="OaProcessDefinition" id="OaProcessDefinitionResult">
        <result property="definitionId" column="definition_id"  />
        <result property="categoryId"   column="category_id"    />
        <result property="processKey"   column="process_key"    />
        <result property="processName"  column="process_name"   />
        <result property="version"      column="version"        />
        <result property="deploymentId" column="deployment_id"  />
        <result property="procDefId"    column="proc_def_id"    />
        <result property="description"  column="description"    />
        <result property="status"       column="status"         />
        <result property="createBy"     column="create_by"      />
        <result property="createTime"   column="create_time"    />
        <result property="updateBy"     column="update_by"      />
        <result property="updateTime"   column="update_time"    />
        <result property="remark"       column="remark"         />
    </resultMap>
    <sql id="selectOaProcessDefinitionVo">
        select definition_id, category_id, process_key, process_name, version, deployment_id, proc_def_id, description, status, create_by, create_time, update_by, update_time, remark from oa_process_definition
    </sql>
    <select id="selectOaProcessDefinitionList" parameterType="OaProcessDefinition" resultMap="OaProcessDefinitionResult">
        <include refid="selectOaProcessDefinitionVo"/>
        <where>
            <if test="categoryId != null"> and category_id = #{categoryId}</if>
            <if test="processKey != null and processKey.trim() != ''"> and process_key like concat('%', #{processKey}, '%')</if>
            <if test="processName != null and processName.trim() != ''"> and process_name like concat('%', #{processName}, '%')</if>
            <if test="status != null and status.trim() != ''"> and status = #{status}</if>
        </where>
        order by version desc
    </select>
    <select id="selectOaProcessDefinitionByDefinitionId" parameterType="Long" resultMap="OaProcessDefinitionResult">
        select definition_id, category_id, process_key, process_name, version, deployment_id, proc_def_id, bpmn_xml, description, status, create_by, create_time, update_by, update_time, remark from oa_process_definition where definition_id = #{definitionId}
    </select>
    <insert id="insertOaProcessDefinition" parameterType="OaProcessDefinition" useGeneratedKeys="true" keyProperty="definitionId">
        insert into oa_process_definition
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="categoryId != null">category_id,</if>
            <if test="processKey != null and processKey != ''">process_key,</if>
            <if test="processName != null and processName != ''">process_name,</if>
            <if test="version != null">version,</if>
            <if test="deploymentId != null">deployment_id,</if>
            <if test="procDefId != null">proc_def_id,</if>
            <if test="bpmnXml != null">bpmn_xml,</if>
            <if test="description != null">description,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="categoryId != null">#{categoryId},</if>
            <if test="processKey != null and processKey != ''">#{processKey},</if>
            <if test="processName != null and processName != ''">#{processName},</if>
            <if test="version != null">#{version},</if>
            <if test="deploymentId != null">#{deploymentId},</if>
            <if test="procDefId != null">#{procDefId},</if>
            <if test="bpmnXml != null">#{bpmnXml},</if>
            <if test="description != null">#{description},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>
    <update id="updateOaProcessDefinition" parameterType="OaProcessDefinition">
        update oa_process_definition
        <trim prefix="SET" suffixOverrides=",">
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="processKey != null and processKey != ''">process_key = #{processKey},</if>
            <if test="processName != null and processName != ''">process_name = #{processName},</if>
            <if test="version != null">version = #{version},</if>
            <if test="deploymentId != null">deployment_id = #{deploymentId},</if>
            <if test="procDefId != null">proc_def_id = #{procDefId},</if>
            <if test="bpmnXml != null">bpmn_xml = #{bpmnXml},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where definition_id = #{definitionId}
    </update>
    <delete id="deleteOaProcessDefinitionByDefinitionId" parameterType="Long">
        delete from oa_process_definition where definition_id = #{definitionId}
    </delete>
    <delete id="deleteOaProcessDefinitionByDefinitionIds" parameterType="String">
        delete from oa_process_definition where definition_id in
        <foreach item="definitionId" collection="array" open="(" separator="," close=")">#{definitionId}</foreach>
    </delete>
</mapper>
