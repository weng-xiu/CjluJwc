<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yu.sam.mapper.SamStudentMapper">
    <resultMap type="SamStudent" id="SamStudentResult">
        <result property="studentId"         column="student_id"         />
        <result property="studentNo"         column="student_no"         />
        <result property="studentName"       column="student_name"       />
        <result property="gender"            column="gender"             />
        <result property="birthDate"         column="birth_date"         />
        <result property="idCard"            column="id_card"            />
        <result property="majorId"           column="major_id"           />
        <result property="userId"            column="user_id"            />
        <result property="deptId"            column="dept_id"            />
        <result property="classId"           column="class_id"           />
        <result property="enrollmentYear"    column="enrollment_year"    />
        <result property="educationLevel"    column="education_level"    />
        <result property="studentStatus"     column="student_status"     />
        <result property="status"            column="status"             />
        <result property="createBy"          column="create_by"          />
        <result property="createTime"        column="create_time"        />
        <result property="updateBy"          column="update_by"         />
        <result property="updateTime"        column="update_time"        />
        <result property="remark"          column="remark"            />
    </resultMap>
    <!-- P6 门户本人学籍：在基础字段上补充院系/专业/班级名称展示字段 -->
    <resultMap type="SamStudent" id="SamStudentPortalInfoResult" extends="SamStudentResult">
        <result property="deptName"  column="dept_name"   />
        <result property="majorName" column="major_name"  />
        <result property="className" column="class_name"  />
    </resultMap>
    <sql id="selectSamStudentVo">
        select student_id, student_no, student_name, gender, birth_date, id_card, major_id, dept_id, class_id, enrollment_year, education_level, student_status, status, create_by, create_time, update_by, update_time, remark from sam_student
    </sql>
    <select id="selectSamStudentList" parameterType="SamStudent" resultMap="SamStudentResult">
        select s.student_id, s.student_no, s.student_name, s.gender, s.birth_date, s.id_card, s.major_id, s.user_id, s.dept_id, s.class_id, s.enrollment_year, s.education_level, s.student_status, s.status, s.create_by, s.create_time, s.update_by, s.update_time, s.remark
        from sam_student s
        left join sys_dept d on s.dept_id = d.dept_id
        <where>
            <if test="studentNo != null and studentNo.trim() != ''"> and s.student_no like concat('%', #{studentNo}, '%')</if>
            <if test="studentName != null and studentName.trim() != ''"> and s.student_name like concat('%', #{studentName}, '%')</if>
            <if test="gender != null and gender.trim() != ''"> and s.gender = #{gender}</if>
            <if test="majorId != null"> and s.major_id = #{majorId}</if>
            <if test="deptId != null"> and s.dept_id = #{deptId}</if>
            <if test="classId != null"> and s.class_id = #{classId}</if>
            <if test="studentStatus != null and studentStatus.trim() != ''"> and s.student_status = #{studentStatus}</if>
            <if test="status != null and status.trim() != ''"> and s.status = #{status}</if>
            <!-- 数据范围过滤 -->
            ${params.dataScope}
        </where>
    </select>
    <select id="selectSamStudentByStudentId" parameterType="Long" resultMap="SamStudentResult">
        <include refid="selectSamStudentVo"/> where student_id = #{studentId}
    </select>
    <!-- P6：门户端按登录用户ID查本人学籍（不走数据权限过滤，附院系/专业/班级名称） -->
    <select id="selectSamStudentByUserId" parameterType="Long" resultMap="SamStudentPortalInfoResult">
        select s.student_id, s.student_no, s.student_name, s.gender, s.birth_date, s.id_card,
               s.major_id, s.user_id, s.dept_id, s.class_id, s.enrollment_year, s.education_level,
               s.student_status, s.status, s.create_by, s.create_time, s.update_by, s.update_time, s.remark,
               d.dept_name as dept_name, m.major_name as major_name, c.class_name as class_name
        from sam_student s
        left join brm_department d on s.dept_id = d.dept_id
        left join brm_major m on s.major_id = m.major_id
        left join brm_class c on s.class_id = c.class_id
        where s.user_id = #{userId} limit 1
    </select>
    <insert id="insertSamStudent" parameterType="SamStudent" useGeneratedKeys="true" keyProperty="studentId">
        insert into sam_student
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="studentNo != null and studentNo != ''">student_no,</if>
            <if test="studentName != null and studentName != ''">student_name,</if>
            <if test="gender != null">gender,</if>
            <if test="birthDate != null">birth_date,</if>
            <if test="idCard != null">id_card,</if>
            <if test="majorId != null">major_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="classId != null">class_id,</if>
            <if test="enrollmentYear != null">enrollment_year,</if>
            <if test="educationLevel != null">education_level,</if>
            <if test="studentStatus != null">student_status,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="studentNo != null and studentNo != ''">#{studentNo},</if>
            <if test="studentName != null and studentName != ''">#{studentName},</if>
            <if test="gender != null">#{gender},</if>
            <if test="birthDate != null">#{birthDate},</if>
            <if test="idCard != null">#{idCard},</if>
            <if test="majorId != null">#{majorId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="classId != null">#{classId},</if>
            <if test="enrollmentYear != null">#{enrollmentYear},</if>
            <if test="educationLevel != null">#{educationLevel},</if>
            <if test="studentStatus != null">#{studentStatus},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>
    <update id="updateSamStudent" parameterType="SamStudent">
        update sam_student
        <trim prefix="SET" suffixOverrides=",">
            <if test="studentNo != null and studentNo != ''">student_no = #{studentNo},</if>
            <if test="studentName != null and studentName != ''">student_name = #{studentName},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="birthDate != null">birth_date = #{birthDate},</if>
            <if test="idCard != null">id_card = #{idCard},</if>
            <if test="majorId != null">major_id = #{majorId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="classId != null">class_id = #{classId},</if>
            <if test="enrollmentYear != null">enrollment_year = #{enrollmentYear},</if>
            <if test="educationLevel != null">education_level = #{educationLevel},</if>
            <if test="studentStatus != null">student_status = #{studentStatus},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where student_id = #{studentId}
    </update>
    <delete id="deleteSamStudentByStudentId" parameterType="Long">
        delete from sam_student where student_id = #{studentId}
    </delete>
    <delete id="deleteSamStudentByStudentIds" parameterType="String">
        delete from sam_student where student_id in
        <foreach item="studentId" collection="array" open="(" separator="," close=")">#{studentId}</foreach>
    </delete>

    <select id="checkStudentHasGradeRecord" parameterType="Long" resultType="int">
        select count(1) from aem_grade_record where student_id = #{studentId}
    </select>

    <select id="selectSamStudentByStudentNo" parameterType="String" resultMap="SamStudentResult">
        <include refid="selectSamStudentVo"/> where student_no = #{studentNo} limit 1
    </select>
    <select id="countMajorExists" parameterType="Long" resultType="int">
        select count(1) from brm_major where major_id = #{majorId}
    </select>
    <select id="countDeptExists" parameterType="Long" resultType="int">
        select count(1) from brm_department where dept_id = #{deptId}
    </select>
    <select id="countClassExists" parameterType="Long" resultType="int">
        select count(1) from brm_class where class_id = #{classId}
    </select>
    <select id="countIdCardConflict" resultType="int">
        select count(1) from sam_student where id_card = #{idCard}
        <if test="studentId != null"> and student_id != #{studentId}</if>
    </select>
</mapper>
