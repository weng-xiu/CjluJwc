<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yu.sam.mapper.SamWarningAssistMapper">
    <resultMap type="SamWarningAssist" id="SamWarningAssistResult">
        <id property="assistId" column="assist_id"/>
        <result property="warningId" column="warning_id"/>
        <result property="studentId" column="student_id"/>
        <result property="semesterId" column="semester_id"/>
