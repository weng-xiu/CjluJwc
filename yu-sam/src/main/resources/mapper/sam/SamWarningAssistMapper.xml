    <update id="updateSamWarningAssist" parameterType="SamWarningAssist">
        update sam_warning_assist
        <trim prefix="SET" suffixOverrides=",">
            <if test="helperUserId != null">helper_user_id = #{helperUserId},</if>
            <if test="helperName != null">helper_name = #{helperName},</if>
            <if test="assistStatus != null">assist_status = #{assistStatus},</if>
            <if test="measure != null">measure = #{measure},</if>
            <if test="followCount != null">follow_count = #{followCount},</if>
            <if test="lastFollowTime != null">last_follow_time = #{lastFollowTime},</if>
