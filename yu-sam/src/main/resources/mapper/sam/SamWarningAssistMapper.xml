    <sql id="selectSamWarningAssistVo">
        select assist_id, warning_id, student_id, semester_id, student_name, student_no, warning_type, warning_level,
               helper_user_id, helper_name, assist_status, measure, follow_count, last_follow_time, claim_time,
               finish_time, finish_remark, create_by, create_time, update_by, update_time, remark
        from sam_warning_assist
    </sql>

    <select id="selectSamWarningAssistByAssistId" parameterType="Long" resultMap="SamWarningAssistResult">
        <include refid="selectSamWarningAssistVo"/> where assist_id = #{assistId}
    </select>

    <select id="selectSamWarningAssistList" parameterType="SamWarningAssist" resultMap="SamWarningAssistResult">
        <include refid="selectSamWarningAssistVo"/>
        <where>
            <if test="warningId != null"> and warning_id = #{warningId}</if>
            <if test="studentId != null"> and student_id = #{studentId}</if>
            <if test="semesterId != null"> and semester_id = #{semesterId}</if>
            <if test="studentName != null and studentName.trim() != ''"> and student_name like concat('%', #{studentName}, '%')</if>
            <if test="warningType != null and warningType != ''"> and warning_type = #{warningType}</if>
            <if test="warningLevel != null and warningLevel != ''"> and warning_level = #{warningLevel}</if>
            <if test="helperUserId != null"> and helper_user_id = #{helperUserId}</if>
            <if test="assistStatus != null and assistStatus != ''"> and assist_status = #{assistStatus}</if>
        </where>
        order by assist_id desc
    </select>

    <select id="selectByWarningId" resultMap="SamWarningAssistResult">
        <include refid="selectSamWarningAssistVo"/> where warning_id = #{warningId} limit 1
    </select>

    <select id="countPendingByHelper" resultType="int">
        select count(1) from sam_warning_assist where helper_user_id = #{helperUserId} and assist_status in ('0','1')
    </select>

    <insert id="insertSamWarningAssist" parameterType="SamWarningAssist" useGeneratedKeys="true" keyProperty="assistId">
