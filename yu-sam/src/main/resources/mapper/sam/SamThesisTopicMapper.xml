<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yu.sam.mapper.SamThesisTopicMapper">
    <resultMap type="SamThesisTopic" id="SamThesisTopicResult">
        <result property="topicId"       column="topic_id"       />
        <result property="planYear"      column="plan_year"      />
        <result property="topicName"     column="topic_name"     />
        <result property="topicSource"   column="topic_source"   />
        <result property="majorId"       column="major_id"       />
        <result property="deptId"        column="dept_id"        />
        <result property="advisor"       column="advisor"        />
        <result property="advisorName"   column="advisor_name"   />
        <result property="capacity"      column="capacity"       />
        <result property="electedCount"  column="elected_count"  />
        <result property="difficulty"    column="difficulty"     />
        <result property="intro"         column="intro"          />
        <result property="status"        column="status"         />
        <result property="auditOpinion"  column="audit_opinion"  />
        <result property="remark"        column="remark"         />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
    </resultMap>
    <sql id="selectSamThesisTopicVo">
        select topic_id, plan_year, topic_name, topic_source, major_id, dept_id, advisor, advisor_name,
               capacity, elected_count, difficulty, intro, status, audit_opinion, remark,
               create_by, create_time, update_by, update_time
        from sam_thesis_topic
    </sql>
    <select id="selectSamThesisTopicList" parameterType="SamThesisTopic" resultMap="SamThesisTopicResult">
        <include refid="selectSamThesisTopicVo"/>
        <where>
            <if test="planYear != null and planYear.trim() != ''"> and plan_year = #{planYear}</if>
            <if test="topicName != null and topicName.trim() != ''"> and topic_name like concat('%', #{topicName}, '%')</if>
            <if test="topicSource != null and topicSource.trim() != ''"> and topic_source = #{topicSource}</if>
            <if test="majorId != null"> and major_id = #{majorId}</if>
            <if test="deptId != null"> and dept_id = #{deptId}</if>
            <if test="advisor != null and advisor.trim() != ''"> and advisor = #{advisor}</if>
            <if test="advisorName != null and advisorName.trim() != ''"> and advisor_name like concat('%', #{advisorName}, '%')</if>
            <if test="status != null and status.trim() != ''"> and status = #{status}</if>
        </where>
        order by plan_year desc, topic_id desc
    </select>
    <select id="selectSamThesisTopicByTopicId" parameterType="Long" resultMap="SamThesisTopicResult">
        <include refid="selectSamThesisTopicVo"/> where topic_id = #{topicId}
    </select>
    <!-- 名额占用：容量未满才自增，返回受影响行数（0 表示已被选满）
         注：MySQL 的 UPDATE 赋值按书写顺序求值，后置表达式取的是已更新后的列值 -->
    <update id="occupyTopic" parameterType="Long">
        update sam_thesis_topic
        set elected_count = ifnull(elected_count, 0) + 1,
            status = case when elected_count &gt;= ifnull(capacity, 1) then '2' else status end
        where topic_id = #{topicId}
          and ifnull(elected_count, 0) &lt; ifnull(capacity, 1)
    </update>
    <!-- 名额释放：删除论文档案时回退，并把因选满而置 2 的题目恢复为可选题 -->
    <update id="releaseTopic" parameterType="Long">
        update sam_thesis_topic
        set elected_count = case when ifnull(elected_count, 0) &gt; 0 then elected_count - 1 else 0 end,
            status = case when status = '2' and elected_count &lt; ifnull(capacity, 1) then '1' else status end
        where topic_id = #{topicId}
    </update>
    <insert id="insertSamThesisTopic" parameterType="SamThesisTopic" useGeneratedKeys="true" keyProperty="topicId">
        insert into sam_thesis_topic
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="planYear != null and planYear != ''">plan_year,</if>
            <if test="topicName != null and topicName != ''">topic_name,</if>
            <if test="topicSource != null">topic_source,</if>
            <if test="majorId != null">major_id,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="advisor != null">advisor,</if>
            <if test="advisorName != null">advisor_name,</if>
            <if test="capacity != null">capacity,</if>
            <if test="electedCount != null">elected_count,</if>
            <if test="difficulty != null">difficulty,</if>
            <if test="intro != null">intro,</if>
            <if test="status != null">status,</if>
            <if test="auditOpinion != null">audit_opinion,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="planYear != null and planYear != ''">#{planYear},</if>
            <if test="topicName != null and topicName != ''">#{topicName},</if>
            <if test="topicSource != null">#{topicSource},</if>
            <if test="majorId != null">#{majorId},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="advisor != null">#{advisor},</if>
            <if test="advisorName != null">#{advisorName},</if>
            <if test="capacity != null">#{capacity},</if>
            <if test="electedCount != null">#{electedCount},</if>
            <if test="difficulty != null">#{difficulty},</if>
            <if test="intro != null">#{intro},</if>
            <if test="status != null">#{status},</if>
            <if test="auditOpinion != null">#{auditOpinion},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>
    <update id="updateSamThesisTopic" parameterType="SamThesisTopic">
        update sam_thesis_topic
        <trim prefix="SET" suffixOverrides=",">
            <if test="planYear != null and planYear != ''">plan_year = #{planYear},</if>
            <if test="topicName != null and topicName != ''">topic_name = #{topicName},</if>
            <if test="topicSource != null">topic_source = #{topicSource},</if>
            <if test="majorId != null">major_id = #{majorId},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="advisor != null">advisor = #{advisor},</if>
            <if test="advisorName != null">advisor_name = #{advisorName},</if>
            <if test="capacity != null">capacity = #{capacity},</if>
            <if test="electedCount != null">elected_count = #{electedCount},</if>
            <if test="difficulty != null">difficulty = #{difficulty},</if>
            <if test="intro != null">intro = #{intro},</if>
            <if test="status != null">status = #{status},</if>
            <if test="auditOpinion != null">audit_opinion = #{auditOpinion},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where topic_id = #{topicId}
    </update>
    <delete id="deleteSamThesisTopicByTopicId" parameterType="Long">
        delete from sam_thesis_topic where topic_id = #{topicId}
    </delete>
    <delete id="deleteSamThesisTopicByTopicIds" parameterType="String">
        delete from sam_thesis_topic where topic_id in
        <foreach item="topicId" collection="array" open="(" separator="," close=")">#{topicId}</foreach>
    </delete>
</mapper>
