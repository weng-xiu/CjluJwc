<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yu.sam.mapper.SamObeGraduationRequirementMapper">
    <resultMap type="SamObeGraduationRequirement" id="SamObeGraduationRequirementResult">
        <result property="grId"        column="gr_id"        />
        <result property="planId"      column="plan_id"      />
        <result property="grCode"      column="gr_code"      />
        <result property="grName"      column="gr_name"      />
        <result property="grDesc"      column="gr_desc"      />
        <result property="targetValue" column="target_value" />
        <result property="sortOrder"   column="sort_order"   />
        <result property="status"      column="status"       />
        <result property="delFlag"     column="del_flag"     />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"  column="update_time"  />
        <result property="remark"      column="remark"       />
    </resultMap>
    <sql id="selectVo">
        select gr_id, plan_id, gr_code, gr_name, gr_desc, target_value, sort_order, status, del_flag,
               create_by, create_time, update_by, update_time, remark
        from sam_obe_graduation_requirement
    </sql>
    <select id="selectSamObeGraduationRequirementList" parameterType="SamObeGraduationRequirement" resultMap="SamObeGraduationRequirementResult">
        <include refid="selectVo"/>
        <where>
            del_flag = '0'
            <if test="planId != null"> and plan_id = #{planId}</if>
            <if test="grCode != null and grCode.trim() != ''"> and gr_code = #{grCode}</if>
            <if test="grName != null and grName.trim() != ''"> and gr_name like concat('%', #{grName}, '%')</if>
            <if test="status != null and status.trim() != ''"> and status = #{status}</if>
        </where>
        order by plan_id, sort_order, gr_id
    </select>
    <select id="selectSamObeGraduationRequirementByGrId" parameterType="Long" resultMap="SamObeGraduationRequirementResult">
        <include refid="selectVo"/> where gr_id = #{grId} and del_flag = '0'
    </select>
    <select id="selectByPlanId" parameterType="Long" resultMap="SamObeGraduationRequirementResult">
        <include refid="selectVo"/> where plan_id = #{planId} and del_flag = '0' and status = '0' order by sort_order, gr_id
    </select>
    <insert id="insertSamObeGraduationRequirement" parameterType="SamObeGraduationRequirement" useGeneratedKeys="true" keyProperty="grId">
        insert into sam_obe_graduation_requirement
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="planId != null">plan_id,</if>
            <if test="grCode != null">gr_code,</if>
            <if test="grName != null">gr_name,</if>
            <if test="grDesc != null">gr_desc,</if>
            <if test="targetValue != null">target_value,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="planId != null">#{planId},</if>
            <if test="grCode != null">#{grCode},</if>
            <if test="grName != null">#{grName},</if>
            <if test="grDesc != null">#{grDesc},</if>
            <if test="targetValue != null">#{targetValue},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>
    <update id="updateSamObeGraduationRequirement" parameterType="SamObeGraduationRequirement">
        update sam_obe_graduation_requirement
        <trim prefix="SET" suffixOverrides=",">
            <if test="planId != null">plan_id = #{planId},</if>
            <if test="grCode != null">gr_code = #{grCode},</if>
            <if test="grName != null">gr_name = #{grName},</if>
            <if test="grDesc != null">gr_desc = #{grDesc},</if>
            <if test="targetValue != null">target_value = #{targetValue},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where gr_id = #{grId}
    </update>
    <delete id="deleteSamObeGraduationRequirementByGrIds" parameterType="String">
        update sam_obe_graduation_requirement set del_flag = '2' where gr_id in
        <foreach item="grId" collection="array" open="(" separator="," close=")">#{grId}</foreach>
    </delete>
</mapper>
