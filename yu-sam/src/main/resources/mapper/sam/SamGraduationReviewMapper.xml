    <delete id="deleteSamGraduationReviewByReviewId" parameterType="Long">
        delete from sam_graduation_review where review_id = #{reviewId}
    </delete>
    <delete id="deleteSamGraduationReviewByReviewIds" parameterType="String">
        delete from sam_graduation_review where review_id in
        <foreach item="reviewId" collection="array" open="(" separator="," close=")">#{reviewId}</foreach>
    </delete>
</mapper>
