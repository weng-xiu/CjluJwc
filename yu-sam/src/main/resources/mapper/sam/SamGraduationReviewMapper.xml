    <sql id="selectSamGraduationReviewVo">
        select review_id, student_id, total_credits_earned, required_credits, is_credit_qualified, is_course_qualified, is_english_qualified, is_pe_qualified, review_status, review_date, reviewer, review_opinion, status, create_by, create_time, update_by, update_time, remark from sam_graduation_review
    </sql>
    <select id="selectSamGraduationReviewList" parameterType="SamGraduationReview" resultMap="SamGraduationReviewResult">
        <include refid="selectSamGraduationReviewVo"/>
        <where>
            <if test="studentId != null"> and student_id = #{studentId}</if>
            <if test="reviewStatus != null and reviewStatus.trim() != ''"> and review_status = #{reviewStatus}</if>
            <if test="status != null and status.trim() != ''"> and status = #{status}</if>
        </where>
    </select>
    <select id="selectSamGraduationReviewByReviewId" parameterType="Long" resultMap="SamGraduationReviewResult">
        <include refid="selectSamGraduationReviewVo"/> where review_id = #{reviewId}
    </select>
    <insert id="insertSamGraduationReview" parameterType="SamGraduationReview" useGeneratedKeys="true" keyProperty="reviewId">
        insert into sam_graduation_review
        <trim prefix="(" suffix=")" suffixOverrides=",">
