<mapper namespace="com.yu.sam.mapper.SamGraduationReviewMapper">
    <resultMap type="SamGraduationReview" id="SamGraduationReviewResult">
        <result property="reviewId"            column="review_id"             />
        <result property="studentId"           column="student_id"            />
        <result property="totalCreditsEarned"  column="total_credits_earned"  />
        <result property="requiredCredits"     column="required_credits"      />
        <result property="isCreditQualified"   column="is_credit_qualified"   />
