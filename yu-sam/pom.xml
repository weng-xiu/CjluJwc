<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>yu</artifactId>
        <groupId>com.yu</groupId>
        <version>3.9.2</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>yu-sam</artifactId>

    <properties>
        <!-- JaCoCo 行覆盖率防回归棘轮（Q1 第十六批收口 sam 长尾9控制器接口层：证书补办/学位配置/学位审核/毕业手续/手续环节/注册登记/预警/预警规则/预警帮扶，实测 ~26.4%，下限取 0.24）-->
        <jacoco.line.minimum>0.24</jacoco.line.minimum>
    </properties>

    <description>
        学籍与学位管理模块
    </description>

    <dependencies>

        <!-- 通用工具-->
        <dependency>
            <groupId>com.yu</groupId>
            <artifactId>yu-common</artifactId>
        </dependency>

        <!-- 基础资源管理模块（关联院系、专业、班级、教师、学生等）-->
        <dependency>
            <groupId>com.yu</groupId>
            <artifactId>yu-brm</artifactId>
        </dependency>

        <!-- OA工作流模块（学籍异动多级审批依赖Flowable）-->
        <dependency>
            <groupId>com.yu</groupId>
            <artifactId>yu-oa</artifactId>
        </dependency>

        <!-- 单元测试（JUnit5 + Mockito，随 spring-boot-starter-test 传递）-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- MockMvc standalone 需 DispatcherServlet：webmvc 仅测试期使用（运行期由 yu-admin 聚合提供）-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
