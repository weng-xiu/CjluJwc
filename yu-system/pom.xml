<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>yu</artifactId>
        <groupId>com.yu</groupId>
        <version>3.9.2</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>yu-system</artifactId>

    <properties>
        <!-- JaCoCo 行覆盖率防回归棘轮。V6.7 首次建基线 0.08（实测 10.05%，344/3423，54 例）；
             V6.9 补 AiTextAnalyzer（静态纯函数，142/144 行）与 SysDeptServiceImpl（祖先链重算与院系同步，
             85/95 行）共 38 例后，全量单测复跑实测 17.50%（598/3418，92 例），按「实测 − 2 点」上调到 0.15。
             仍为零覆盖的大块：SysPrintServiceImpl（445 行）、SysAiChatServiceImpl（210 行）、
             SysMenuServiceImpl（193 行）、SysAiEvalServiceImpl / SysNotifyServiceImpl（各 109 行）。 -->
        <jacoco.line.minimum>0.15</jacoco.line.minimum>
    </properties>

    <description>
        system系统模块
    </description>

    <dependencies>

        <!-- 通用工具-->
        <dependency>
            <groupId>com.yu</groupId>
            <artifactId>yu-common</artifactId>
        </dependency>

        <!-- 基础资源管理模块（用于账号同步） -->
        <dependency>
            <groupId>com.yu</groupId>
            <artifactId>yu-brm</artifactId>
        </dependency>

        <!-- 打印凭证模板渲染（P4） -->
        <dependency>
            <groupId>org.apache.velocity</groupId>
            <artifactId>velocity-engine-core</artifactId>
        </dependency>

        <!-- S6 多渠道通知：邮件渠道 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- 单元测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>