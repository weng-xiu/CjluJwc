<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yu.system.mapper.SysAiKnowledgeMapper">
    
    <resultMap type="SysAiKnowledge" id="SysAiKnowledgeResult">
        <result     property="knowledgeId"  column="knowledge_id"   />
        <result     property="category"     column="category"       />
        <result     property="title"        column="title"          />
        <result     property="keywords"     column="keywords"       />
        <result     property="content"      column="content"        />
        <result     property="source"       column="source"         />
        <result     property="refUrl"       column="ref_url"        />
        <result     property="hitCount"     column="hit_count"      />
        <result     property="orderNum"     column="order_num"      />
        <result     property="status"       column="status"         />
        <result     property="createBy"     column="create_by"      />
        <result     property="createTime"   column="create_time"    />
        <result     property="updateBy"     column="update_by"      />
        <result     property="updateTime"   column="update_time"    />
        <result     property="remark"       column="remark"         />
        <result     property="summary"      column="summary"        />
    </resultMap>

    <sql id="selectSysAiKnowledgeVo">
        select knowledge_id, category, title, keywords, content, source, ref_url, hit_count, order_num, status, create_by, create_time, update_by, update_time, remark from sys_ai_knowledge
    </sql>

    <!-- 列表态不返回正文全文，仅截取摘要，避免 text 字段拖慢分页 -->
    <select id="selectSysAiKnowledgeList" parameterType="SysAiKnowledge" resultMap="SysAiKnowledgeResult">
        select knowledge_id, category, title, keywords, source, ref_url, hit_count, order_num, status,
               create_by, create_time, update_by, update_time, remark,
               left(content, 120) as summary
        from sys_ai_knowledge
        <where>  
            <if test="category != null and category != ''"> and category = #{category}</if>
            <if test="title != null and title != ''"> and title like concat('%', #{title}, '%')</if>
            <if test="keywords != null and keywords != ''"> and keywords like concat('%', #{keywords}, '%')</if>
            <if test="source != null and source != ''"> and source like concat('%', #{source}, '%')</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
        </where>
        order by category, order_num, knowledge_id
    </select>
    
    <select id="selectSysAiKnowledgeByKnowledgeId" parameterType="Long" resultMap="SysAiKnowledgeResult">
        <include refid="selectSysAiKnowledgeVo"/>
        where knowledge_id = #{knowledgeId}
    </select>

    <select id="selectEnabledList" resultMap="SysAiKnowledgeResult">
        <include refid="selectSysAiKnowledgeVo"/>
        where status = '0'
        order by category, order_num, knowledge_id
    </select>

    <select id="selectCategoryStat" resultType="java.util.HashMap">
        select category as category, count(1) as total, sum(hit_count) as hits,
               sum(case when status = '0' then 1 else 0 end) as enabledTotal
        from sys_ai_knowledge
        group by category
        order by total desc
    </select>

    <select id="selectHotKnowledge" resultType="java.util.HashMap">
        select knowledge_id as knowledgeId, category as category, title as title, hit_count as hitCount
        from sys_ai_knowledge
        where status = '0'
        order by hit_count desc, knowledge_id asc
        limit #{limit}
    </select>

    <insert id="insertSysAiKnowledge" parameterType="SysAiKnowledge" useGeneratedKeys="true" keyProperty="knowledgeId">
        insert into sys_ai_knowledge
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="category != null and category != ''">category,</if>
            <if test="title != null and title != ''">title,</if>
            <if test="keywords != null">keywords,</if>
            <if test="content != null">content,</if>
            <if test="source != null">source,</if>
            <if test="refUrl != null">ref_url,</if>
            <if test="hitCount != null">hit_count,</if>
            <if test="orderNum != null">order_num,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="category != null and category != ''">#{category},</if>
            <if test="title != null and title != ''">#{title},</if>
            <if test="keywords != null">#{keywords},</if>
            <if test="content != null">#{content},</if>
            <if test="source != null">#{source},</if>
            <if test="refUrl != null">#{refUrl},</if>
            <if test="hitCount != null">#{hitCount},</if>
            <if test="orderNum != null">#{orderNum},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateSysAiKnowledge" parameterType="SysAiKnowledge">
        update sys_ai_knowledge
        <trim prefix="SET" suffixOverrides=",">
            <if test="category != null and category != ''">category = #{category},</if>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="keywords != null">keywords = #{keywords},</if>
            <if test="content != null">content = #{content},</if>
            <if test="source != null">source = #{source},</if>
            <if test="refUrl != null">ref_url = #{refUrl},</if>
            <if test="hitCount != null">hit_count = #{hitCount},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where knowledge_id = #{knowledgeId}
    </update>

    <update id="increaseHitCount">
        update sys_ai_knowledge set hit_count = ifnull(hit_count, 0) + 1
        where knowledge_id in 
        <foreach item="knowledgeId" collection="knowledgeIds" open="(" separator="," close=")">
            #{knowledgeId}
        </foreach>
    </update>

    <delete id="deleteSysAiKnowledgeByKnowledgeId" parameterType="Long">
        delete from sys_ai_knowledge where knowledge_id = #{knowledgeId}
    </delete>

    <delete id="deleteSysAiKnowledgeByKnowledgeIds" parameterType="String">
        delete from sys_ai_knowledge where knowledge_id in 
        <foreach item="knowledgeId" collection="array" open="(" separator="," close=")">
            #{knowledgeId}
        </foreach>
    </delete>
</mapper>
