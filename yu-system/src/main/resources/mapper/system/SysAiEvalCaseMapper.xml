<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yu.system.mapper.SysAiEvalCaseMapper">

    <resultMap type="SysAiEvalCase" id="SysAiEvalCaseResult">
        <id     property="caseId"               column="case_id"                 />
        <result property="question"             column="question"                />
        <result property="expectKnowledgeIds"   column="expect_knowledge_ids"    />
        <result property="expectKeywords"       column="expect_keywords"         />
        <result property="category"             column="category"                />
        <result property="sort"                 column="sort"                    />
        <result property="enabled"              column="enabled"                 />
        <result property="remark"               column="remark"                  />
        <result property="createBy"             column="create_by"               />
        <result property="createTime"           column="create_time"             />
        <result property="updateBy"             column="update_by"               />
        <result property="updateTime"           column="update_time"             />
    </resultMap>

    <sql id="selectSysAiEvalCaseVo">
        select case_id, question, expect_knowledge_ids, expect_keywords, category, sort, enabled,
               remark, create_by, create_time, update_by, update_time
        from sys_ai_eval_case
    </sql>

    <select id="selectEvalCaseList" parameterType="SysAiEvalCase" resultMap="SysAiEvalCaseResult">
        <include refid="selectSysAiEvalCaseVo"/>
        <where>
            <if test="question != null and question != ''"> and question like concat('%', #{question}, '%')</if>
            <if test="category != null and category != ''"> and category = #{category}</if>
            <if test="enabled != null and enabled != ''"> and enabled = #{enabled}</if>
        </where>
        order by sort asc, case_id asc
    </select>

    <select id="selectEvalCaseById" parameterType="Long" resultMap="SysAiEvalCaseResult">
        <include refid="selectSysAiEvalCaseVo"/>
        where case_id = #{caseId}
    </select>

    <select id="selectEnabledList" resultMap="SysAiEvalCaseResult">
        <include refid="selectSysAiEvalCaseVo"/>
        where enabled = '0'
        order by sort asc, case_id asc
    </select>

    <insert id="insertEvalCase" parameterType="SysAiEvalCase" useGeneratedKeys="true" keyProperty="caseId">
        insert into sys_ai_eval_case
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="question != null and question != ''">question,</if>
            <if test="expectKnowledgeIds != null">expect_knowledge_ids,</if>
            <if test="expectKeywords != null">expect_keywords,</if>
            <if test="category != null">category,</if>
            <if test="sort != null">sort,</if>
            <if test="enabled != null and enabled != ''">enabled,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="question != null and question != ''">#{question},</if>
            <if test="expectKnowledgeIds != null">#{expectKnowledgeIds},</if>
            <if test="expectKeywords != null">#{expectKeywords},</if>
            <if test="category != null">#{category},</if>
            <if test="sort != null">#{sort},</if>
            <if test="enabled != null and enabled != ''">#{enabled},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateEvalCase" parameterType="SysAiEvalCase">
        update sys_ai_eval_case
        <trim prefix="SET" suffixOverrides=",">
            <if test="question != null and question != ''">question = #{question},</if>
            <if test="expectKnowledgeIds != null">expect_knowledge_ids = #{expectKnowledgeIds},</if>
            <if test="expectKeywords != null">expect_keywords = #{expectKeywords},</if>
            <if test="category != null">category = #{category},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="enabled != null and enabled != ''">enabled = #{enabled},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where case_id = #{caseId}
    </update>

    <delete id="deleteEvalCaseByIds" parameterType="String">
        delete from sys_ai_eval_case where case_id in
        <foreach item="caseId" collection="array" open="(" separator="," close=")">
            #{caseId}
        </foreach>
    </delete>
</mapper>
