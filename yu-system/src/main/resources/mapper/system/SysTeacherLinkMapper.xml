<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yu.system.mapper.SysTeacherLinkMapper">

    <resultMap type="SysTeacherLink" id="SysTeacherLinkResult">
        <id     property="linkId"       column="link_id"       />
        <result property="userId"       column="user_id"       />
        <result property="teacherId"    column="teacher_id"    />
        <result property="teacherCode"  column="teacher_code"  />
        <result property="createTime"   column="create_time"   />
        <result property="userName"     column="user_name"     />
        <result property="teacherName"  column="teacher_name"  />
        <result property="title"        column="title"         />
        <result property="deptName"     column="dept_name"     />
    </resultMap>

    <sql id="selectTeacherLinkVo">
        select l.link_id, l.user_id, l.teacher_id, l.teacher_code, l.create_time,
        u.user_name, t.teacher_name, t.title, d.dept_name
        from sys_teacher_link l
		    left join sys_user u on l.user_id = u.user_id
		    left join brm_teacher t on l.teacher_id = t.teacher_id
		    left join brm_department d on t.dept_id = d.dept_id
    </sql>

    <select id="selectTeacherLinkList" parameterType="SysTeacherLink" resultMap="SysTeacherLinkResult">
        <include refid="selectTeacherLinkVo"/>
        where l.link_id is not null
        <if test="teacherCode != null and teacherCode != ''">
            AND l.teacher_code like concat('%', #{teacherCode}, '%')
        </if>
        <if test="teacherName != null and teacherName != ''">
            AND t.teacher_name like concat('%', #{teacherName}, '%')
        </if>
        <if test="userName != null and userName != ''">
            AND u.user_name like concat('%', #{userName}, '%')
        </if>
        <!-- 数据范围过滤 -->
        ${params.dataScope}
    </select>

    <select id="selectTeacherLinkById" parameterType="Long" resultMap="SysTeacherLinkResult">
        <include refid="selectTeacherLinkVo"/>
        where l.link_id = #{linkId}
    </select>

    <select id="selectTeacherLinkByUserId" parameterType="Long" resultMap="SysTeacherLinkResult">
        <include refid="selectTeacherLinkVo"/>
        where l.user_id = #{userId}
    </select>

    <select id="selectTeacherLinkByTeacherId" parameterType="Long" resultMap="SysTeacherLinkResult">
        <include refid="selectTeacherLinkVo"/>
        where l.teacher_id = #{teacherId}
    </select>

    <insert id="insertTeacherLink" parameterType="SysTeacherLink" useGeneratedKeys="true" keyProperty="linkId">
        insert into sys_teacher_link(
            <if test="userId != null">user_id,</if>
            <if test="teacherId != null">teacher_id,</if>
            <if test="teacherCode != null and teacherCode != ''">teacher_code,</if>
            create_time
        )values(
            <if test="userId != null">#{userId},</if>
            <if test="teacherId != null">#{teacherId},</if>
            <if test="teacherCode != null and teacherCode != ''">#{teacherCode},</if>
            sysdate()
        )
    </insert>

    <update id="updateTeacherLink" parameterType="SysTeacherLink">
        update sys_teacher_link
        <set>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="teacherId != null">teacher_id = #{teacherId},</if>
            <if test="teacherCode != null and teacherCode != ''">teacher_code = #{teacherCode},</if>
            update_time = sysdate()
        </set>
        where link_id = #{linkId}
    </update>

    <delete id="deleteTeacherLinkById" parameterType="Long">
        delete from sys_teacher_link where link_id = #{linkId}
    </delete>

    <delete id="deleteTeacherLinkByUserId" parameterType="Long">
        delete from sys_teacher_link where user_id = #{userId}
    </delete>

    <insert id="batchInsertTeacherLink" parameterType="java.util.List">
        insert into sys_teacher_link(user_id, teacher_id, teacher_code, create_time)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.userId}, #{item.teacherId}, #{item.teacherCode}, sysdate())
        </foreach>
    </insert>

    <select id="checkUserTeacherUnique" parameterType="Long" resultMap="SysTeacherLinkResult">
        select l.link_id, l.user_id, l.teacher_id from sys_teacher_link l where l.user_id = #{userId} limit 1
    </select>

</mapper>
