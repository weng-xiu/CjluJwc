<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yu.system.mapper.SysUserMfaMapper">

    <resultMap type="SysUserMfa" id="SysUserMfaResult">
        <id     property="userId"     column="user_id"     />
        <result property="secret"     column="secret"      />
        <result property="status"     column="status"      />
        <result property="bindTime"   column="bind_time"   />
        <result property="createTime" column="create_time" />
        <result property="updateTime" column="update_time" />
    </resultMap>

    <select id="selectByUserId" parameterType="Long" resultMap="SysUserMfaResult">
        select user_id, secret, status, bind_time, create_time, update_time
        from sys_user_mfa
        where user_id = #{userId}
    </select>

    <!-- 按 user_id 幂等 upsert：存在则更新密钥/状态/时间，不存在则插入 -->
    <insert id="insertOrUpdate" parameterType="SysUserMfa">
        insert into sys_user_mfa (user_id, secret, status, bind_time, create_time)
        values (#{userId}, #{secret}, #{status}, #{bindTime}, #{createTime})
        on duplicate key update
            secret      = values(secret),
            status      = values(status),
            bind_time   = values(bind_time),
            update_time = values(update_time)
    </insert>

    <delete id="deleteByUserId" parameterType="Long">
        delete from sys_user_mfa where user_id = #{userId}
    </delete>

</mapper>
