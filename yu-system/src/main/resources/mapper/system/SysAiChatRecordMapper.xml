<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yu.system.mapper.SysAiChatRecordMapper">
    
    <resultMap type="SysAiChatRecord" id="SysAiChatRecordResult">
        <result     property="recordId"         column="record_id"          />
        <result     property="userId"           column="user_id"            />
        <result     property="userName"         column="user_name"          />
        <result     property="userRole"         column="user_role"          />
        <result     property="scene"            column="scene"              />
        <result     property="question"         column="question"           />
        <result     property="answer"           column="answer"             />
        <result     property="answerSource"     column="answer_source"      />
        <result     property="knowledgeIds"     column="knowledge_ids"      />
        <result     property="knowledgeTitles"  column="knowledge_titles"   />
        <result     property="confidence"       column="confidence"         />
        <result     property="costTime"         column="cost_time"          />
        <result     property="status"           column="status"             />
        <result     property="errorMsg"         column="error_msg"          />
        <result     property="createTime"       column="create_time"        />
    </resultMap>

    <sql id="selectSysAiChatRecordVo">
        select record_id, user_id, user_name, user_role, scene, question, answer, answer_source,
               knowledge_ids, knowledge_titles, confidence, cost_time, status, error_msg, create_time
        from sys_ai_chat_record
    </sql>

    <sql id="chatRecordWhere">
        <where>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="userName != null and userName != ''"> and user_name like concat('%', #{userName}, '%')</if>
            <if test="scene != null and scene != ''"> and scene = #{scene}</if>
            <if test="question != null and question != ''"> and question like concat('%', #{question}, '%')</if>
            <if test="answerSource != null and answerSource != ''"> and answer_source = #{answerSource}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
            <if test="beginTime != null and beginTime != ''"> and create_time &gt;= concat(#{beginTime}, ' 00:00:00')</if>
            <if test="endTime != null and endTime != ''"> and create_time &lt;= concat(#{endTime}, ' 23:59:59')</if>
        </where>
    </sql>

    <select id="selectSysAiChatRecordList" parameterType="SysAiChatRecord" resultMap="SysAiChatRecordResult">
        <include refid="selectSysAiChatRecordVo"/>
        <include refid="chatRecordWhere"/>
        order by record_id desc
    </select>
    
    <select id="selectSysAiChatRecordByRecordId" parameterType="Long" resultMap="SysAiChatRecordResult">
        <include refid="selectSysAiChatRecordVo"/>
        where record_id = #{recordId}
    </select>

    <select id="selectOverviewStat" parameterType="SysAiChatRecord" resultType="java.util.HashMap">
        select count(1) as total,
               ifnull(sum(case when answer_source in ('LLM','EXTRACT') then 1 else 0 end), 0) as hitTotal,
               ifnull(sum(case when answer_source = 'NONE' then 1 else 0 end), 0) as missTotal,
               ifnull(sum(case when answer_source = 'ERROR' then 1 else 0 end), 0) as errorTotal,
               ifnull(round(avg(case when answer_source in ('LLM','EXTRACT') then confidence end), 3), 0) as avgConfidence,
               ifnull(round(avg(cost_time)), 0) as avgCostTime,
               count(distinct user_id) as userTotal
        from sys_ai_chat_record
        <include refid="chatRecordWhere"/>
    </select>

    <select id="selectSourceStat" parameterType="SysAiChatRecord" resultType="java.util.HashMap">
        select ifnull(answer_source, 'UNKNOWN') as answerSource, count(1) as total,
               ifnull(round(avg(confidence), 3), 0) as avgConfidence
        from sys_ai_chat_record
        <include refid="chatRecordWhere"/>
        group by answer_source
        order by total desc
    </select>

    <select id="selectSceneStat" parameterType="SysAiChatRecord" resultType="java.util.HashMap">
        select ifnull(scene, 'unknown') as scene, count(1) as total,
               ifnull(sum(case when answer_source in ('LLM','EXTRACT') then 1 else 0 end), 0) as hitTotal
        from sys_ai_chat_record
        <include refid="chatRecordWhere"/>
        group by scene
        order by total desc
    </select>

    <select id="selectDailyTrend" resultType="java.util.HashMap">
        select stat_date as statDate, total as total, hitTotal as hitTotal
        from (
            select date_format(create_time, '%Y-%m-%d') as stat_date,
                   count(1) as total,
                   sum(case when answer_source in ('LLM','EXTRACT') then 1 else 0 end) as hitTotal
            from sys_ai_chat_record
            where create_time &gt;= date_sub(curdate(), interval #{days} day)
            group by date_format(create_time, '%Y-%m-%d')
        ) t
        order by stat_date
    </select>

    <select id="selectUnmatchedQuestions" resultType="java.util.HashMap">
        select question as question, count(1) as total, max(create_time) as lastTime
        from sys_ai_chat_record
        where answer_source = 'NONE'
        group by question
        order by total desc, lastTime desc
        limit #{limit}
    </select>

    <insert id="insertSysAiChatRecord" parameterType="SysAiChatRecord" useGeneratedKeys="true" keyProperty="recordId">
        insert into sys_ai_chat_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="userName != null">user_name,</if>
            <if test="userRole != null">user_role,</if>
            <if test="scene != null and scene != ''">scene,</if>
            <if test="question != null and question != ''">question,</if>
            <if test="answer != null">answer,</if>
            <if test="answerSource != null and answerSource != ''">answer_source,</if>
            <if test="knowledgeIds != null">knowledge_ids,</if>
            <if test="knowledgeTitles != null">knowledge_titles,</if>
            <if test="confidence != null">confidence,</if>
            <if test="costTime != null">cost_time,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="errorMsg != null">error_msg,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="userName != null">#{userName},</if>
            <if test="userRole != null">#{userRole},</if>
            <if test="scene != null and scene != ''">#{scene},</if>
            <if test="question != null and question != ''">#{question},</if>
            <if test="answer != null">#{answer},</if>
            <if test="answerSource != null and answerSource != ''">#{answerSource},</if>
            <if test="knowledgeIds != null">#{knowledgeIds},</if>
            <if test="knowledgeTitles != null">#{knowledgeTitles},</if>
            <if test="confidence != null">#{confidence},</if>
            <if test="costTime != null">#{costTime},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="errorMsg != null">#{errorMsg},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>
</mapper>
