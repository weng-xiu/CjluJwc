<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yu.system.mapper.SysDataClassMapper">

    <resultMap type="SysDataClass" id="SysDataClassResult">
        <id     property="classId"           column="class_id"           />
        <result property="tableName"         column="table_name"         />
        <result property="tableComment"      column="table_comment"      />
        <result property="columnName"        column="column_name"        />
        <result property="columnComment"     column="column_comment"     />
        <result property="dataCategory"      column="data_category"      />
        <result property="securityLevel"     column="security_level"     />
        <result property="protectionMeasure" column="protection_measure" />
        <result property="isPersonalInfo"    column="is_personal_info"   />
        <result property="status"            column="status"             />
        <result property="remark"            column="remark"             />
        <result property="createBy"          column="create_by"          />
        <result property="createTime"        column="create_time"        />
        <result property="updateBy"          column="update_by"          />
        <result property="updateTime"        column="update_time"        />
    </resultMap>

    <sql id="selectSysDataClassVo">
        select class_id, table_name, table_comment, column_name, column_comment, data_category,
               security_level, protection_measure, is_personal_info, status, remark,
               create_by, create_time, update_by, update_time
        from sys_data_class
    </sql>

    <select id="selectDataClassList" parameterType="SysDataClass" resultMap="SysDataClassResult">
        <include refid="selectSysDataClassVo"/>
        <where>
            <if test="tableName != null and tableName != ''"> and table_name like concat('%', #{tableName}, '%')</if>
            <if test="columnName != null and columnName != ''"> and column_name like concat('%', #{columnName}, '%')</if>
            <if test="dataCategory != null and dataCategory != ''"> and data_category = #{dataCategory}</if>
            <if test="securityLevel != null and securityLevel != ''"> and security_level = #{securityLevel}</if>
            <if test="protectionMeasure != null and protectionMeasure != ''"> and protection_measure = #{protectionMeasure}</if>
            <if test="isPersonalInfo != null and isPersonalInfo != ''"> and is_personal_info = #{isPersonalInfo}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
        </where>
        order by security_level desc, table_name asc, column_name asc
    </select>

    <select id="selectDataClassById" parameterType="Long" resultMap="SysDataClassResult">
        <include refid="selectSysDataClassVo"/>
        where class_id = #{classId}
    </select>

    <select id="selectDataClassByColumn" parameterType="SysDataClass" resultMap="SysDataClassResult">
        <include refid="selectSysDataClassVo"/>
        where table_name = #{tableName} and column_name = #{columnName} limit 1
    </select>

    <insert id="insertDataClass" parameterType="SysDataClass" useGeneratedKeys="true" keyProperty="classId">
        insert into sys_data_class
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="tableName != null and tableName != ''">table_name,</if>
            <if test="tableComment != null">table_comment,</if>
            <if test="columnName != null and columnName != ''">column_name,</if>
            <if test="columnComment != null">column_comment,</if>
            <if test="dataCategory != null and dataCategory != ''">data_category,</if>
            <if test="securityLevel != null and securityLevel != ''">security_level,</if>
            <if test="protectionMeasure != null and protectionMeasure != ''">protection_measure,</if>
            <if test="isPersonalInfo != null and isPersonalInfo != ''">is_personal_info,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="tableName != null and tableName != ''">#{tableName},</if>
            <if test="tableComment != null">#{tableComment},</if>
            <if test="columnName != null and columnName != ''">#{columnName},</if>
            <if test="columnComment != null">#{columnComment},</if>
            <if test="dataCategory != null and dataCategory != ''">#{dataCategory},</if>
            <if test="securityLevel != null and securityLevel != ''">#{securityLevel},</if>
            <if test="protectionMeasure != null and protectionMeasure != ''">#{protectionMeasure},</if>
            <if test="isPersonalInfo != null and isPersonalInfo != ''">#{isPersonalInfo},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateDataClass" parameterType="SysDataClass">
        update sys_data_class
        <trim prefix="SET" suffixOverrides=",">
            <if test="tableName != null and tableName != ''">table_name = #{tableName},</if>
            <if test="tableComment != null">table_comment = #{tableComment},</if>
            <if test="columnName != null and columnName != ''">column_name = #{columnName},</if>
            <if test="columnComment != null">column_comment = #{columnComment},</if>
            <if test="dataCategory != null and dataCategory != ''">data_category = #{dataCategory},</if>
            <if test="securityLevel != null and securityLevel != ''">security_level = #{securityLevel},</if>
            <if test="protectionMeasure != null and protectionMeasure != ''">protection_measure = #{protectionMeasure},</if>
            <if test="isPersonalInfo != null and isPersonalInfo != ''">is_personal_info = #{isPersonalInfo},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where class_id = #{classId}
    </update>

    <delete id="deleteDataClassById" parameterType="Long">
        delete from sys_data_class where class_id = #{classId}
    </delete>

    <delete id="deleteDataClassByIds" parameterType="String">
        delete from sys_data_class where class_id in
        <foreach item="classId" collection="array" open="(" separator="," close=")">
            #{classId}
        </foreach>
    </delete>
</mapper>
