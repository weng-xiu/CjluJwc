<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yu.dis.mapper.DisSourcePriorityMapper">
    <resultMap type="DisSourcePriority" id="DisSourcePriorityResult">
        <result property="priorityId"    column="priority_id"    />
        <result property="sourceCode"    column="source_code"    />
        <result property="sourceName"    column="source_name"    />
        <result property="priority"      column="priority"       />
        <result property="status"        column="status"         />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"        column="remark"         />
    </resultMap>
    <sql id="selectDisSourcePriorityVo">select priority_id, source_code, source_name, priority, status, create_by, create_time, update_by, update_time, remark from dis_source_priority</sql>
    <select id="selectDisSourcePriorityList" parameterType="DisSourcePriority" resultMap="DisSourcePriorityResult">
        <include refid="selectDisSourcePriorityVo"/><where>
            <if test="sourceCode != null and sourceCode.trim() != ''"> and source_code like concat('%', #{sourceCode}, '%')</if>
            <if test="sourceName != null and sourceName.trim() != ''"> and source_name like concat('%', #{sourceName}, '%')</if>
            <if test="status != null and status.trim() != ''"> and status = #{status}</if>
        </where> order by priority desc, priority_id
    </select>
    <select id="selectDisSourcePriorityByPriorityId" parameterType="Long" resultMap="DisSourcePriorityResult"><include refid="selectDisSourcePriorityVo"/> where priority_id = #{priorityId}</select>
    <select id="selectEnabledList" resultMap="DisSourcePriorityResult"><include refid="selectDisSourcePriorityVo"/> where status = '0' order by priority desc</select>
    <insert id="insertDisSourcePriority" parameterType="DisSourcePriority" useGeneratedKeys="true" keyProperty="priorityId">insert into dis_source_priority
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="sourceCode != null and sourceCode != ''">source_code,</if>
            <if test="sourceName != null">source_name,</if>
            <if test="priority != null">priority,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if><if test="createTime != null">create_time,</if><if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="sourceCode != null and sourceCode != ''">#{sourceCode},</if>
            <if test="sourceName != null">#{sourceName},</if>
            <if test="priority != null">#{priority},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if><if test="createTime != null">#{createTime},</if><if test="remark != null">#{remark},</if>
        </trim>
    </insert>
    <update id="updateDisSourcePriority" parameterType="DisSourcePriority">update dis_source_priority
        <trim prefix="SET" suffixOverrides=",">
            <if test="sourceCode != null and sourceCode != ''">source_code = #{sourceCode},</if>
            <if test="sourceName != null">source_name = #{sourceName},</if>
            <if test="priority != null">priority = #{priority},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if><if test="updateTime != null">update_time = #{updateTime},</if><if test="remark != null">remark = #{remark},</if>
        </trim> where priority_id = #{priorityId}
    </update>
    <delete id="deleteDisSourcePriorityByPriorityId" parameterType="Long">delete from dis_source_priority where priority_id = #{priorityId}</delete>
    <delete id="deleteDisSourcePriorityByPriorityIds" parameterType="String">delete from dis_source_priority where priority_id in <foreach item="priorityId" collection="array" open="(" separator="," close=")">#{priorityId}</foreach></delete>
</mapper>
