<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>yu</artifactId>
        <groupId>com.yu</groupId>
        <version>3.9.2</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>yu-generator</artifactId>

    <properties>
        <!-- JaCoCo 行覆盖率防回归棘轮。V6.10 首次建基线：本模块此前无 src/test，
             新增 GenUtilsTest / VelocityUtilsTest / GenTableServiceImplTest 共 45 例后
             实测 78.80%（591/750 行；分支 75.96%），按「实测 − 2 点」取 0.76。
             previewCode/downloadCode 走真 Velocity 渲染（不 mock 模板引擎），
             因此这组数字代表「模板 + 上下文变量」确实被跑过而不是被绕过。
             仍为零覆盖的大块：GenController（69 行，@Controller 层等 MockMvc 批次）、
             GenConfig（12 行，@Value setter，只给 Spring 容器用）——不靠棘轮倒逼硬测。 -->
        <jacoco.line.minimum>0.76</jacoco.line.minimum>
    </properties>

    <description>
        generator代码生成
    </description>

    <dependencies>

        <!-- velocity代码生成使用模板 -->
        <dependency>
            <groupId>org.apache.velocity</groupId>
            <artifactId>velocity-engine-core</artifactId>
        </dependency>

        <!-- 通用工具-->
        <dependency>
            <groupId>com.yu</groupId>
            <artifactId>yu-common</artifactId>
        </dependency>

        <!-- 阿里数据库连接池 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-4-starter</artifactId>
        </dependency>

        <!-- 单元测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>