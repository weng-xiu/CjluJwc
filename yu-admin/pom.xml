<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>yu</artifactId>
        <groupId>com.yu</groupId>
        <version>3.9.2</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <packaging>jar</packaging>
    <artifactId>yu-admin</artifactId>

    <properties>
        <!-- JaCoCo 行覆盖率防回归棘轮（仅统计 yu-admin 自有 com.yu.web 代码，Q1⑫批后实测 ~33.8%，下限保守取 0.30） -->
        <jacoco.line.minimum>0.30</jacoco.line.minimum>
    </properties>

    <description>
        web服务入口
    </description>

    <dependencies>

        <!-- spring-boot-devtools -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional> <!-- 表示依赖不会传递 -->
        </dependency>

        <!-- spring-doc -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- 可观测性基座（V4.0 A5）：actuator 提供 health/info/metrics，健康检查不再依赖 /dev/tcp 探活；
             暴露面由 application-prod.yml 收敛为 health,info 并受 Spring Security 保护 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 可观测性（Q3）：Micrometer Prometheus 注册表，暴露 /actuator/prometheus 供 Prometheus 抓取；
             JVM/接口/缓存/业务指标统一经此导出，版本由 spring-boot BOM 管理 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- 数据库迁移引擎（V4.0 A6）：基线化 sql/ 下 35 个 phase 手工脚本；
             默认 spring.flyway.enabled=false，新环境建库/发布时显式开启 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

         <!-- Mysql驱动包 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- 核心模块-->
        <dependency>
            <groupId>com.yu</groupId>
            <artifactId>yu-framework</artifactId>
        </dependency>

        <!-- 定时任务-->
        <dependency>
            <groupId>com.yu</groupId>
            <artifactId>yu-quartz</artifactId>
        </dependency>

        <!-- 代码生成-->
        <dependency>
            <groupId>com.yu</groupId>
            <artifactId>yu-generator</artifactId>
        </dependency>

        <!-- 基础资源管理-->
        <dependency>
            <groupId>com.yu</groupId>
            <artifactId>yu-brm</artifactId>
        </dependency>

        <!-- 培养过程管理-->
        <dependency>
            <groupId>com.yu</groupId>
            <artifactId>yu-tpm</artifactId>
        </dependency>

        <!-- 考核与评价管理-->
        <dependency>
            <groupId>com.yu</groupId>
            <artifactId>yu-aem</artifactId>
        </dependency>

        <!-- 学籍与学位管理-->
        <dependency>
            <groupId>com.yu</groupId>
            <artifactId>yu-sam</artifactId>
        </dependency>

        <!-- 数据对接与共享-->
        <dependency>
            <groupId>com.yu</groupId>
            <artifactId>yu-dis</artifactId>
        </dependency>

        <!-- 师生互动服务门户-->
        <dependency>
            <groupId>com.yu</groupId>
            <artifactId>yu-portal</artifactId>
        </dependency>

        <!-- 办公自动化 -->
        <dependency>
            <groupId>com.yu</groupId>
            <artifactId>yu-oa</artifactId>
        </dependency>

        <!-- 单元测试（JUnit5 + Mockito + MockMvc，Q1 第七批系统管理接口层测试；webmvc 由 yu-framework 传递提供）-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <addResources>true</addResources>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>   
                <groupId>org.apache.maven.plugins</groupId>   
                <artifactId>maven-war-plugin</artifactId>   
                <version>3.1.0</version>   
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                    <warName>${project.artifactId}</warName>
                </configuration>   
           </plugin>   
        </plugins>
        <finalName>${project.artifactId}</finalName>
    </build>

</project>