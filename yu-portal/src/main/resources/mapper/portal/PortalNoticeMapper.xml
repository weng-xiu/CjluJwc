<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yu.portal.mapper.PortalNoticeMapper">
    <resultMap type="PortalNotice" id="PortalNoticeResult">
        <result property="noticeId"          column="notice_id"          />
        <result property="noticeTitle"       column="notice_title"       />
        <result property="noticeType"        column="notice_type"        />
        <result property="noticeContent"     column="notice_content"     />
        <result property="publishDeptId"     column="publish_dept_id"    />
        <result property="publishDeptName"   column="publish_dept_name"  />
        <result property="publishStatus"     column="publish_status"     />
        <result property="publishDate"       column="publish_date"       />
        <result property="targetRole"        column="target_role"        />
        <result property="isTop"             column="is_top"             />
        <result property="viewCount"         column="view_count"         />
        <result property="status"            column="status"             />
        <result property="createBy"          column="create_by"          />
        <result property="createTime"        column="create_time"        />
        <result property="updateBy"          column="update_by"          />
        <result property="updateTime"        column="update_time"        />
        <result property="remark"            column="remark"             />
    </resultMap>
    <sql id="selectPortalNoticeVo">
        select notice_id, notice_title, notice_type, notice_content, publish_dept_id, publish_dept_name, publish_status, publish_date, target_role, is_top, view_count, status, create_by, create_time, update_by, update_time, remark from portal_notice
    </sql>
    <select id="selectPortalNoticeList" parameterType="PortalNotice" resultMap="PortalNoticeResult">
        <include refid="selectPortalNoticeVo"/>
        <where>
            <if test="noticeTitle != null and noticeTitle.trim() != ''"> and notice_title like concat('%', #{noticeTitle}, '%')</if>
            <if test="noticeType != null and noticeType.trim() != ''"> and notice_type = #{noticeType}</if>
            <if test="publishStatus != null and publishStatus.trim() != ''"> and publish_status = #{publishStatus}</if>
            <if test="publishDeptName != null and publishDeptName.trim() != ''"> and publish_dept_name like concat('%', #{publishDeptName}, '%')</if>
            <if test="targetRole != null and targetRole.trim() != ''"> and (target_role = '0' or target_role = #{targetRole})</if>
            <if test="isTop != null and isTop.trim() != ''"> and is_top = #{isTop}</if>
            <if test="status != null and status.trim() != ''"> and status = #{status}</if>
        </where>
        order by is_top desc, publish_date desc, create_time desc
    </select>
    <select id="selectPortalNoticeByNoticeId" parameterType="Long" resultMap="PortalNoticeResult">
        <include refid="selectPortalNoticeVo"/> where notice_id = #{noticeId}
    </select>
    <insert id="insertPortalNotice" parameterType="PortalNotice" useGeneratedKeys="true" keyProperty="noticeId">
        insert into portal_notice
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="noticeTitle != null and noticeTitle != ''">notice_title,</if>
            <if test="noticeType != null">notice_type,</if>
            <if test="noticeContent != null">notice_content,</if>
            <if test="publishDeptId != null">publish_dept_id,</if>
            <if test="publishDeptName != null">publish_dept_name,</if>
            <if test="publishStatus != null">publish_status,</if>
            <if test="publishDate != null">publish_date,</if>
            <if test="targetRole != null">target_role,</if>
            <if test="isTop != null">is_top,</if>
            <if test="viewCount != null">view_count,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="noticeTitle != null and noticeTitle != ''">#{noticeTitle},</if>
            <if test="noticeType != null">#{noticeType},</if>
            <if test="noticeContent != null">#{noticeContent},</if>
            <if test="publishDeptId != null">#{publishDeptId},</if>
            <if test="publishDeptName != null">#{publishDeptName},</if>
            <if test="publishStatus != null">#{publishStatus},</if>
            <if test="publishDate != null">#{publishDate},</if>
            <if test="targetRole != null">#{targetRole},</if>
            <if test="isTop != null">#{isTop},</if>
            <if test="viewCount != null">#{viewCount},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>
    <update id="updatePortalNotice" parameterType="PortalNotice">
        update portal_notice
        <trim prefix="SET" suffixOverrides=",">
            <if test="noticeTitle != null and noticeTitle != ''">notice_title = #{noticeTitle},</if>
            <if test="noticeType != null">notice_type = #{noticeType},</if>
            <if test="noticeContent != null">notice_content = #{noticeContent},</if>
            <if test="publishDeptId != null">publish_dept_id = #{publishDeptId},</if>
            <if test="publishDeptName != null">publish_dept_name = #{publishDeptName},</if>
            <if test="publishStatus != null">publish_status = #{publishStatus},</if>
            <if test="publishDate != null">publish_date = #{publishDate},</if>
            <if test="targetRole != null">target_role = #{targetRole},</if>
            <if test="isTop != null">is_top = #{isTop},</if>
            <if test="viewCount != null">view_count = #{viewCount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where notice_id = #{noticeId}
    </update>
    <delete id="deletePortalNoticeByNoticeId" parameterType="Long">
        delete from portal_notice where notice_id = #{noticeId}
    </delete>
    <delete id="deletePortalNoticeByNoticeIds" parameterType="String">
        delete from portal_notice where notice_id in
        <foreach item="noticeId" collection="array" open="(" separator="," close=")">#{noticeId}</foreach>
    </delete>
</mapper>
