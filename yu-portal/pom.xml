<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>yu</artifactId>
        <groupId>com.yu</groupId>
        <version>3.9.2</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>yu-portal</artifactId>

    <description>
        师生互动服务门户模块，整合BRM/TPM/AEM/SAM/DIS数据，提供学生/教师前台服务入口
    </description>

    <dependencies>

        <!-- 通用工具-->
        <dependency>
            <groupId>com.yu</groupId>
            <artifactId>yu-common</artifactId>
        </dependency>

        <!-- 基础资源管理模块（学年学期、院系、专业、教师、教室等）-->
        <dependency>
            <groupId>com.yu</groupId>
            <artifactId>yu-brm</artifactId>
        </dependency>

        <!-- 培养过程管理模块（培养方案、排课、选课等）-->
        <dependency>
            <groupId>com.yu</groupId>
            <artifactId>yu-tpm</artifactId>
        </dependency>

        <!-- 考核与评价管理模块（考试、成绩、评教等）-->
        <dependency>
            <groupId>com.yu</groupId>
            <artifactId>yu-aem</artifactId>
        </dependency>

        <!-- 学籍与学位管理模块（学籍、毕业审核等）-->
        <dependency>
            <groupId>com.yu</groupId>
            <artifactId>yu-sam</artifactId>
        </dependency>

        <!-- 数据对接与共享模块-->
        <dependency>
            <groupId>com.yu</groupId>
            <artifactId>yu-dis</artifactId>
        </dependency>

    </dependencies>

</project>
