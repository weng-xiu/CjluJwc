<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yu.tpm.mapper.TpmPlanSnapshotMapper">
    <resultMap type="TpmPlanSnapshot" id="TpmPlanSnapshotResult">
        <result property="snapshotId"           column="snapshot_id"            />
        <result property="planId"               column="plan_id"                />
        <result property="version"              column="version"                />
        <result property="contentHash"          column="content_hash"           />
        <result property="totalCredit"          column="total_credit"           />
        <result property="creditStructureJson"  column="credit_structure_json"  />
        <result property="courseListJson"       column="course_list_json"       />
        <result property="publishDate"          column="publish_date"           />
        <result property="snapshotTime"         column="snapshot_time"          />
        <result property="createBy"             column="create_by"              />
        <result property="createTime"           column="create_time"            />
        <result property="remark"               column="remark"                 />
    </resultMap>

    <sql id="selectTpmPlanSnapshotVo">
        select snapshot_id, plan_id, version, content_hash, total_credit, credit_structure_json,
               course_list_json, publish_date, snapshot_time, create_by, create_time, remark
        from tpm_plan_snapshot
    </sql>

    <select id="selectTpmPlanSnapshotBySnapshotId" parameterType="Long" resultMap="TpmPlanSnapshotResult">
        <include refid="selectTpmPlanSnapshotVo"/> where snapshot_id = #{snapshotId}
    </select>

    <select id="selectSnapshotsByPlanId" parameterType="Long" resultMap="TpmPlanSnapshotResult">
        <include refid="selectTpmPlanSnapshotVo"/>
        where plan_id = #{planId}
        order by snapshot_id desc
    </select>

    <select id="selectTpmPlanSnapshotList" parameterType="TpmPlanSnapshot" resultMap="TpmPlanSnapshotResult">
        <include refid="selectTpmPlanSnapshotVo"/>
        <where>
            <if test="planId != null"> and plan_id = #{planId}</if>
            <if test="version != null and version != ''"> and version = #{version}</if>
            <if test="contentHash != null and contentHash != ''"> and content_hash = #{contentHash}</if>
        </where>
        order by snapshot_id desc
    </select>

    <insert id="insertTpmPlanSnapshot" parameterType="TpmPlanSnapshot" useGeneratedKeys="true" keyProperty="snapshotId">
        insert into tpm_plan_snapshot
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="planId != null">plan_id,</if>
            <if test="version != null">version,</if>
            <if test="contentHash != null">content_hash,</if>
            <if test="totalCredit != null">total_credit,</if>
            <if test="creditStructureJson != null">credit_structure_json,</if>
            <if test="courseListJson != null">course_list_json,</if>
            <if test="publishDate != null">publish_date,</if>
            <if test="snapshotTime != null">snapshot_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="planId != null">#{planId},</if>
            <if test="version != null">#{version},</if>
            <if test="contentHash != null">#{contentHash},</if>
            <if test="totalCredit != null">#{totalCredit},</if>
            <if test="creditStructureJson != null">#{creditStructureJson},</if>
            <if test="courseListJson != null">#{courseListJson},</if>
            <if test="publishDate != null">#{publishDate},</if>
            <if test="snapshotTime != null">#{snapshotTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>
</mapper>
