<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yu.aem.mapper.AemEvaluationQuestionnaireMapper">
    <resultMap type="AemEvaluationQuestionnaire" id="AemEvaluationQuestionnaireResult">
        <result property="questionnaireId"   column="questionnaire_id"    />
        <result property="semesterId"        column="semester_id"         />
        <result property="title"             column="title"               />
        <result property="description"       column="description"         />
        <result property="questionCount"     column="question_count"      />
        <result property="fullScore"         column="full_score"          />
        <result property="startTime"         column="start_time"          />
        <result property="endTime"           column="end_time"            />
        <result property="evalStatus"        column="eval_status"         />
        <result property="isAnonymous"       column="is_anonymous"        />
        <result property="status"            column="status"              />
        <result property="createBy"          column="create_by"           />
        <result property="createTime"        column="create_time"         />
        <result property="updateBy"          column="update_by"           />
        <result property="updateTime"        column="update_time"         />
        <result property="remark"            column="remark"              />
    </resultMap>
    <sql id="selectAemEvaluationQuestionnaireVo">
        select questionnaire_id, semester_id, title, description, question_count, full_score, start_time, end_time, eval_status, is_anonymous, status, create_by, create_time, update_by, update_time, remark from aem_evaluation_questionnaire
    </sql>
    <select id="selectAemEvaluationQuestionnaireList" parameterType="AemEvaluationQuestionnaire" resultMap="AemEvaluationQuestionnaireResult">
        <include refid="selectAemEvaluationQuestionnaireVo"/>
        <where>
            <if test="semesterId != null"> and semester_id = #{semesterId}</if>
            <if test="title != null and title.trim() != ''"> and title like concat('%', #{title}, '%')</if>
            <if test="evalStatus != null and evalStatus.trim() != ''"> and eval_status = #{evalStatus}</if>
            <if test="status != null and status.trim() != ''"> and status = #{status}</if>
        </where>
    </select>
    <select id="selectAemEvaluationQuestionnaireByQuestionnaireId" parameterType="Long" resultMap="AemEvaluationQuestionnaireResult">
        <include refid="selectAemEvaluationQuestionnaireVo"/> where questionnaire_id = #{questionnaireId}
    </select>
    <insert id="insertAemEvaluationQuestionnaire" parameterType="AemEvaluationQuestionnaire" useGeneratedKeys="true" keyProperty="questionnaireId">
        insert into aem_evaluation_questionnaire
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="semesterId != null">semester_id,</if>
            <if test="title != null and title != ''">title,</if>
            <if test="description != null">description,</if>
            <if test="questionCount != null">question_count,</if>
            <if test="fullScore != null">full_score,</if>
            <if test="startTime != null">start_time,</if>
            <if test="endTime != null">end_time,</if>
            <if test="evalStatus != null">eval_status,</if>
            <if test="isAnonymous != null">is_anonymous,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="semesterId != null">#{semesterId},</if>
            <if test="title != null and title != ''">#{title},</if>
            <if test="description != null">#{description},</if>
            <if test="questionCount != null">#{questionCount},</if>
            <if test="fullScore != null">#{fullScore},</if>
            <if test="startTime != null">#{startTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="evalStatus != null">#{evalStatus},</if>
            <if test="isAnonymous != null">#{isAnonymous},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>
    <update id="updateAemEvaluationQuestionnaire" parameterType="AemEvaluationQuestionnaire">
        update aem_evaluation_questionnaire
        <trim prefix="SET" suffixOverrides=",">
            <if test="semesterId != null">semester_id = #{semesterId},</if>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="description != null">description = #{description},</if>
            <if test="questionCount != null">question_count = #{questionCount},</if>
            <if test="fullScore != null">full_score = #{fullScore},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="evalStatus != null">eval_status = #{evalStatus},</if>
            <if test="isAnonymous != null">is_anonymous = #{isAnonymous},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where questionnaire_id = #{questionnaireId}
    </update>
    <delete id="deleteAemEvaluationQuestionnaireByQuestionnaireId" parameterType="Long">
        delete from aem_evaluation_questionnaire where questionnaire_id = #{questionnaireId}
    </delete>
    <delete id="deleteAemEvaluationQuestionnaireByQuestionnaireIds" parameterType="String">
        delete from aem_evaluation_questionnaire where questionnaire_id in
        <foreach item="questionnaireId" collection="array" open="(" separator="," close=")">#{questionnaireId}</foreach>
    </delete>
</mapper>
