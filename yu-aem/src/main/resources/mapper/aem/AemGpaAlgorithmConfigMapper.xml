<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yu.aem.mapper.AemGpaAlgorithmConfigMapper">
    <resultMap type="AemGpaAlgorithmConfig" id="AemGpaAlgorithmConfigResult">
        <result property="configId"       column="config_id"       />
        <result property="algorithmCode"  column="algorithm_code"  />
        <result property="algorithmName"  column="algorithm_name"  />
        <result property="description"    column="description"     />
        <result property="isDefault"      column="is_default"      />
        <result property="status"         column="status"          />
        <result property="createBy"       column="create_by"       />
        <result property="createTime"     column="create_time"     />
        <result property="updateBy"       column="update_by"       />
        <result property="updateTime"     column="update_time"     />
        <result property="remark"         column="remark"          />
    </resultMap>
    <sql id="selectAemGpaAlgorithmConfigVo">
        select config_id, algorithm_code, algorithm_name, description, is_default, status, create_by, create_time, update_by, update_time, remark from aem_gpa_algorithm_config
    </sql>
    <select id="selectAemGpaAlgorithmConfigList" parameterType="AemGpaAlgorithmConfig" resultMap="AemGpaAlgorithmConfigResult">
        <include refid="selectAemGpaAlgorithmConfigVo"/>
        <where>
            <if test="algorithmCode != null and algorithmCode.trim() != ''"> and algorithm_code = #{algorithmCode}</if>
            <if test="algorithmName != null and algorithmName.trim() != ''"> and algorithm_name like concat('%', #{algorithmName}, '%')</if>
            <if test="isDefault != null and isDefault.trim() != ''"> and is_default = #{isDefault}</if>
            <if test="status != null and status.trim() != ''"> and status = #{status}</if>
        </where>
    </select>
    <select id="selectAemGpaAlgorithmConfigById" parameterType="Long" resultMap="AemGpaAlgorithmConfigResult">
        <include refid="selectAemGpaAlgorithmConfigVo"/> where config_id = #{configId}
    </select>
    <insert id="insertAemGpaAlgorithmConfig" parameterType="AemGpaAlgorithmConfig" useGeneratedKeys="true" keyProperty="configId">
        insert into aem_gpa_algorithm_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="algorithmCode != null and algorithmCode != ''">algorithm_code,</if>
            <if test="algorithmName != null and algorithmName != ''">algorithm_name,</if>
            <if test="description != null and description != ''">description,</if>
            <if test="isDefault != null and isDefault != ''">is_default,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="algorithmCode != null and algorithmCode != ''">#{algorithmCode},</if>
            <if test="algorithmName != null and algorithmName != ''">#{algorithmName},</if>
            <if test="description != null and description != ''">#{description},</if>
            <if test="isDefault != null and isDefault != ''">#{isDefault},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>
    <update id="updateAemGpaAlgorithmConfig" parameterType="AemGpaAlgorithmConfig">
        update aem_gpa_algorithm_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="algorithmCode != null and algorithmCode != ''">algorithm_code = #{algorithmCode},</if>
            <if test="algorithmName != null and algorithmName != ''">algorithm_name = #{algorithmName},</if>
            <if test="description != null">description = #{description},</if>
            <if test="isDefault != null and isDefault != ''">is_default = #{isDefault},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where config_id = #{configId}
    </update>
    <delete id="deleteAemGpaAlgorithmConfigById" parameterType="Long">
        delete from aem_gpa_algorithm_config where config_id = #{configId}
    </delete>
    <delete id="deleteAemGpaAlgorithmConfigByIds" parameterType="String">
        delete from aem_gpa_algorithm_config where config_id in
        <foreach item="configId" collection="array" open="(" separator="," close=")">#{configId}</foreach>
    </delete>
    <select id="selectDefaultAlgorithm" resultMap="AemGpaAlgorithmConfigResult">
        <include refid="selectAemGpaAlgorithmConfigVo"/> where is_default = '1' and status = '0' limit 1
    </select>
    <update id="updateAllDefaultToZero">
        update aem_gpa_algorithm_config set is_default = '0'
    </update>
</mapper>
