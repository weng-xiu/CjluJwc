<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>yu</artifactId>
        <groupId>com.yu</groupId>
        <version>3.9.2</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>yu-aem</artifactId>

    <properties>
        <!-- JaCoCo 行覆盖率防回归棘轮（Q1 第十七批补测 aem 长尾12控制器接口层：评教问卷/问题/结果/统计、考试安排/监考/座位、成绩复核/统计/权重、督导记录、GPA算法配置，实测 ~16.3%，下限取 0.14） -->
        <jacoco.line.minimum>0.14</jacoco.line.minimum>
    </properties>

    <description>
        考核与评价管理模块
    </description>

    <dependencies>

        <!-- 通用工具-->
        <dependency>
            <groupId>com.yu</groupId>
            <artifactId>yu-common</artifactId>
        </dependency>

        <!-- 基础资源管理模块（关联学年学期、院系、教师、学生等）-->
        <dependency>
            <groupId>com.yu</groupId>
            <artifactId>yu-brm</artifactId>
        </dependency>

        <!-- OA模块（O1：成绩变更接入 Flowable 多级审批流程）-->
        <dependency>
            <groupId>com.yu</groupId>
            <artifactId>yu-oa</artifactId>
        </dependency>

        <!-- 单元测试（JUnit5 + Mockito + MockMvc，Q1 第四批接口层测试）-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- MockMvc standalone 需 DispatcherServlet：webmvc 仅测试期使用（运行期由 yu-admin 聚合提供）-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
